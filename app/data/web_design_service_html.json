" href=\"/web-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/2.webp\" alt=\"Web Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Web Hosting</h4>\n                        <p>Fast &amp; affordable hosting</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/wordpress-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/4.webp\" alt=\"WordPress Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>WordPress Hosting</h4>\n                        <p>Optimized for WordPress</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/website-builder-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2026/02/5.webp\" alt=\"Website Builder Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Website Builder Hosting</h4>\n                        <p>Build a site easily</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/cloud-servers\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/1.webp\" alt=\"Cloud Servers\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Cloud Servers</h4>\n                        <p>Scale when you grow</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/vps-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/3.webp\" alt=\"VPS Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>VPS Hosting</h4>\n                        <p>Dedicated resources</p>\n                    </span>\n                </a>\n                    </div>\n    </div>\n\n    \n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</header>\n\t\t\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"4442\" class=\"elementor elementor-4442\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d3606ae e-con-full e-flex e-con e-parent\" data-id=\"d3606ae\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e31910f elementor-widget elementor-widget-shortcode\" data-id=\"e31910f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\"><style>\n    /* VARIABLES & RESET */\n    :root {\n        --wh-primary: #0CC0DF;\n        --wh-primary-dark: #0896af;\n        --wh-text: #0f172a;\n        --wh-text-light: #64748b;\n        --wh-bg-gradient: radial-gradient(at 0% 0%, hsla(192,90%,90%,1) 0, transparent 50%), radial-gradient(at 100% 100%, hsla(192,90%,95%,1) 0, transparent 50%);\n        --wh-glass: rgba(255, 255, 255, 0.7);\n        --wh-glass-border: rgba(255, 255, 255, 0.5);\n        --wh-shadow: 0 10px 40px -10px rgba(12, 192, 223, 0.15);\n        --wh-shadow-hover: 0 20px 50px -10px rgba(12, 192, 223, 0.25);\n    }\n\n    .whnz_modern_4456 {\n        font-family: 'Inter', system-ui, -apple-system, sans-serif;\n        color: var(--wh-text);\n        background: #f8fafc;\n        background-image: var(--wh-bg-gradient);\n        background-attachment: fixed;\n        width: 100%;\n        overflow-x: hidden;\n        position: relative;\n    }\n\n    .whnz_modern_4456 * { box-sizing: border-box; }\n    \n    .whnz_modern_4456 section {\n        position: relative;\n        padding: 100px 20px;\n        max-width: 1200px;\n        margin: 0 auto;\n    }\n\n    /* TYPOGRAPHY */\n    .whnz_modern_4456 h1, .whnz_modern_4456 h2, .whnz_modern_4456 h3 {\n        font-weight: 800;\n        letter-spacing: -0.03em;\n        line-height: 1.1;\n        margin: 0 0 1rem 0;\n    }\n\n    .whnz_modern_4456 h2 { font-size: 3rem; text-align: center; margin-bottom: 1rem; }\n    .whnz_modern_4456 p.subtitle { \n        text-align: center; \n        font-size: 1.25rem; \n        color: var(--wh-text-light); \n        max-width: 600px; \n        margin: 0 auto 4rem auto; \n    }\n\n    .whnz_modern_4456 .gradient-text {\n        background: linear-gradient(135deg, var(--wh-primary) 0%, #2563eb 100%);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n        background-clip: text;\n    }\n\n    /* BUTTONS */\n    .whnz_modern_4456 .btn-wrapper {\n        display: flex;\n        gap: 1rem;\n        flex-wrap: wrap;\n    }\n\n    .whnz_modern_4456 .wh-btn {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        padding: 1rem 2rem;\n        border-radius: 50px;\n        font-weight: 700;\n        text-decoration: none;\n        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n        position: relative;\n        overflow: hidden;\n        font-size: 1rem;\n    }\n\n    .whnz_modern_4456 .wh-btn-primary {\n        background: var(--wh-primary);\n        color: white;\n        box-shadow: 0 4px 15px rgba(12, 192, 223, 0.4);\n    }\n\n    .whnz_modern_4456 .wh-btn-primary:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 8px 25px rgba(12, 192, 223, 0.5);\n        background: var(--wh-primary-dark);\n    }\n\n    .whnz_modern_4456 .wh-btn-outline {\n        background: white;\n        color: var(--wh-text);\n        border: 1px solid rgba(0,0,0,0.1);\n    }\n\n    .whnz_modern_4456 .wh-btn-outline:hover {\n        border-color: var(--wh-primary);\n        color: var(--wh-primary);\n        transform: translateY(-2px);\n    }\n\n    /* === HERO SECTION FIX === */\n    .whnz_modern_4456 .hero {\n        min-height: 90vh;\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        align-items: center;\n        gap: 4rem;\n        /* INCREASED PADDING FOR DESKTOP */\n        padding-top: 180px; \n        padding-bottom: 100px;\n    }\n\n    .whnz_modern_4456 .hero-content {\n        z-index: 2;\n        animation: fadeUp 1s ease forwards;\n    }\n\n    .whnz_modern_4456 .hero h1 {\n        font-size: clamp(3rem, 5vw, 4.5rem);\n        margin-bottom: 1.5rem;\n    }\n\n    .whnz_modern_4456 .hero p {\n        font-size: 1.25rem;\n        color: var(--wh-text-light);\n        margin-bottom: 2.5rem;\n        line-height: 1.6;\n    }\n\n    .whnz_modern_4456 .hero-visual {\n        position: relative;\n        perspective: 1000px;\n    }\n\n    /* Browser Mockup */\n    .whnz_modern_4456 .browser-card {\n        background: rgba(255, 255, 255, 0.45);\n        backdrop-filter: blur(20px);\n        -webkit-backdrop-filter: blur(20px);\n        border: 1px solid var(--wh-glass-border);\n        border-radius: 20px;\n        box-shadow: var(--wh-shadow-hover);\n        padding: 1rem;\n        transform: rotateY(-10deg) rotateX(5deg);\n        transition: transform 0.5s ease;\n        animation: float 6s ease-in-out infinite;\n    }\n\n    .whnz_modern_4456 .browser-card:hover { transform: rotateY(0) rotateX(0); }\n\n    .whnz_modern_4456 .browser-header {\n        display: flex;\n        gap: 8px;\n        margin-bottom: 1rem;\n        padding-bottom: 1rem;\n        border-bottom: 1px solid rgba(0,0,0,0.05);\n    }\n\n    .whnz_modern_4456 .dot { width: 12px; height: 12px; border-radius: 50%; }\n    .whnz_modern_4456 .dot.r { background: #ff5f57; }\n    .whnz_modern_4456 .dot.y { background: #ffbd2e; }\n    .whnz_modern_4456 .dot.g { background: #28ca41; }\n\n    .whnz_modern_4456 .browser-body {\n        background: white;\n        border-radius: 8px;\n        height: 300px;\n        position: relative;\n        overflow: hidden;\n        display: flex;\n        flex-direction: column;\n        gap: 15px;\n        padding: 20px;\n    }\n\n    .whnz_modern_4456 .skel { background: #f1f5f9; border-radius: 4px; overflow: hidden; position: relative; }\n    .whnz_modern_4456 .skel::after {\n        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);\n        transform: translateX(-100%);\n        animation: shimmer 2s infinite;\n    }\n    .whnz_modern_4456 .skel.h { height: 40px; width: 70%; }\n    .whnz_modern_4456 .skel.t { height: 100px; width: 100%; }\n    .whnz_modern_4456 .skel.b { height: 40px; width: 30%; border-radius: 20px; background: #e0f2fe; }\n\n    /* FEATURES */\n    .whnz_modern_4456 .features-grid {\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n        gap: 2rem;\n    }\n\n    .whnz_modern_4456 .feature-card {\n        background: var(--wh-glass);\n        backdrop-filter: blur(10px);\n        border: 1px solid white;\n        padding: 2.5rem;\n        border-radius: 24px;\n        transition: all 0.4s ease;\n        opacity: 0;\n        transform: translateY(