ia-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/2.png\" alt=\"Web Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Web Hosting</h4>\n                        <p>Fast &amp; affordable hosting</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/wordpress-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/4.png\" alt=\"WordPress Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>WordPress Hosting</h4>\n                        <p>Optimized for WordPress</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/website-builder-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2026/02/5.jpg\" alt=\"Website Builder Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Website Builder Hosting</h4>\n                        <p>Build a site easily</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/cloud-servers\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/1.png\" alt=\"Cloud Servers\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Cloud Servers</h4>\n                        <p>Scale when you grow</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/vps-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/3.png\" alt=\"VPS Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>VPS Hosting</h4>\n                        <p>Dedicated resources</p>\n                    </span>\n                </a>\n                    </div>\n    </div>\n\n    \n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</header>\n\t\t\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"5115\" class=\"elementor elementor-5115\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-bf2ec38 e-con-full e-flex e-con e-parent\" data-id=\"bf2ec38\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-721304d elementor-widget elementor-widget-shortcode\" data-id=\"721304d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n    \n    \n    \n    \n            \n    \n    <style>\n        /* Smooth scrolling for anchor links */\n        html { scroll-behavior: smooth; }\n\n        :root {\n            --whnz-cyan: #0CC0DF; \n            --whnz-cyan-dark: #0aa5c0;\n            --whnz-bg: #f4f7f9;\n            --whnz-text: #333333;\n            --whnz-card-shadow: 0 20px 40px rgba(11, 18, 32, 0.08);\n            --whnz-input-border: #cbd5e1;\n            --g-yellow: #FBBC05;\n        }\n\n        /* --- GLOBAL WRAPPER --- */\n        .whnz-landing-page {\n            font-family: 'Poppins', sans-serif;\n            color: var(--whnz-text);\n            line-height: 1.6;\n            overflow-x: hidden; /* Prevents horizontal scrollbar */\n        }\n\n        /* --- HERO SECTION (True Full Bleed) --- */\n        .whnz-hero-wrapper {\n            background: radial-gradient(circle at top left, #cbf4fa 0%, #ffffff 65%);\n            \n            /* Aggressive Full Bleed Trick */\n            width: 100vw;\n            max-width: 100vw;\n            margin-left: calc(50% - 50vw);\n            margin-right: calc(50% - 50vw);\n            box-sizing: border-box;\n            \n            /* Pull background up under the transparent header */\n            margin-top: -150px; \n            \n            /* Massive top padding so content safely clears the header */\n            padding: 250px 20px 80px 20px; \n            \n            margin-bottom: 80px;\n        }\n\n        .whnz-hero {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 60px;\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        .whnz-hero-content {\n            flex: 1.2;\n        }\n\n        .whnz-hero-overline {\n            color: var(--whnz-cyan);\n            font-weight: 800;\n            font-size: 11px;\n            letter-spacing: 2px;\n            text-transform: uppercase;\n            margin-bottom: 15px;\n            display: block;\n        }\n\n        .whnz-hero-content h1 {\n            font-size: 52px;\n            font-weight: 800;\n            color: #0b1220;\n            margin-bottom: 20px;\n            line-height: 1.15;\n            letter-spacing: -1px;\n        }\n\n        .whnz-hero-content h1 span {\n            color: var(--whnz-cyan);\n        }\n\n        .whnz-hero-content p {\n            font-size: 16px;\n            color: #475569;\n            margin-bottom: 35px;\n            max-width: 90%;\n            font-weight: 400;\n        }\n\n        .whnz-hero-buttons {\n            display: flex;\n            gap: 15px;\n            flex-wrap: wrap;\n        }\n\n        .whnz-btn-primary {\n            display: inline-flex;\n            background: var(--whnz-cyan);\n            color: #ffffff;\n            padding: 14px 32px;\n            font-size: 15px;\n            font-weight: 700;\n            border-radius: 30px;\n            text-decoration: none;\n            box-shadow: 0 10px 20px rgba(12, 192, 223, 0.25);\n            transition: all 0.3s ease;\n            align-items: center;\n            justify-content: center;\n        }\n        .whnz-btn-primary:hover {\n            background: var(--whnz-cyan-dark);\n            transform: translateY(-2px);\n            box-shadow: 0 12px 25px rgba(12, 192, 223, 0.35);\n            color: #fff;\n        }\n\n        .whnz-btn-secondary {\n            display: inline-flex;\n            background: #ffffff;\n            color: #0b1220;\n            padding: 14px 32px;\n            font-size: 15px;\n            font-weight: 600;\n            border-radius: 30px;\n            border: 1px solid #e2e8f0;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.02);\n        }\n        .whnz-btn-secondary:hover {\n            border-color: #cbd5e1;\n            background: #f8fafc;\n            transform: translateY(-2px);\n        }\n\n        .whnz-hero-image {\n            flex: 1;\n            text-align: right;\n        }\n\n        .whnz-hero-image img {\n            max-width: 100%;\n            height: auto;\n            border-radius: 12px;\n            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));\n            animation: floatImage 6s ease-in-out infinite;\n        }\n        \n        @keyframes floatImage {\n            0% { transform: translateY(0px); }\n            50% { transform: translateY(-10px); }\n            100% { transform: translateY(0px); }\n        }\n\n        /* --- MAIN CONTAINER --- */\n        .whnz-tool-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        /* --- SECTION HEADERS --- */\n        .whnz-section-header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n        .whnz-section-header h2 {\n            font-size: 32px;\n            font-weight: 800;\n            color: #0b1220;\n            margin-bottom: 15px;\n            letter-spacing: -0.5px;\n        }\n        .whnz-section-header p {\n            font-size: 16px;\n            color: #475569;\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* --- TOOL WRAPPER --- */\n        .whnz-qr-wrapper {\n            background: #ffffff;\n            border: 1px solid var(--whnz-input-border);\n            border-radius: 20px;\n            padding: 40px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.03);\n            display: grid;\n            grid-template-columns: 1fr 1.2fr;\n            gap: 50px;\n            margin-bottom: 80px;\n            scroll-margin-top: 100px;\n        }\n\n        /* Form Controls */\n        .whnz-controls { display: flex; flex-direction: column; gap: 20px; }\n        .whnz-control-group { display: flex; flex-direction: column; gap: 8px; }\n        .whnz-control-group label { font-weight: 600; font-size: 14px; color: #475569; }\n\n        .whnz-control-group input[type=\"text\"],\n        .whnz-control-group select {\n            padding: 12px 16px; border: 1px solid var(--whnz-input-border); border-radius: 8px;\n            font-size: 14px; outline: none; transition: all 0.3s ease; width: 100%; box-sizing: border-box; background: #fff;\n            font-family: 'Poppins', sans-serif;\n        }\n\n        .whnz-control-group input[type=\"text\"]:focus,\n        .whnz-control-group select:focus { border-color: var(--whnz-cyan); box-shadow: 0 0 0 3px rgba(12, 192, 223, 0.15); }\n\n        .whnz-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }\n\n        .whnz-color-picker { display: flex; align-items: center; gap: 10px; }\n        .whnz-color-picker input[type=\"color\"] {\n            -webkit-appearance: none; border: none; width: 100%; height: 42px;\n            border-radius: 8px; cursor: pointer; padding: 0; background: none;\n        }\n        .whnz-color-picker input[type=\"color\"]::-webkit-color-swatch-wrapper { padding: 0; }\n        .whnz-color-picker input[type=\"color\"]::-webkit-color-swatch { border: 1px solid #ddd; border-radius: 8px; }\n\n        .whnz-divider { height: 1px; background: #e2e8f0; margin: 10px 0; }\n        .whnz-error-msg { color: #e53e3e; font-size: 13px; margin-top: 5px; display: none; }\n\n        /* Card Preview Section */\n        .whnz-preview-section {\n            display: flex; flex-direction: column; align-items: center; justify-content: center;\n            background: var(--whnz-bg); padding: 40px 20px; border-radius: 16px; overflow: hidden;\n        }\n\n        /* Base Card Container */\n        .whnz-card-container {\n            background: #ffffff; box-shadow: var(--whnz-card-shadow); position: relative;\n            overflow: hidden; transition: all 0.4s ease; box-sizing: border-box; display: flex;\n            --brand-color-1: #EA4335; \n            --brand-color-2: #34A853;\n        }\n\n        /* Layouts */\n        .whnz-format-stand { width: 320px; min-height: 480px; border-radius: 16px; flex-direction: column; }\n        .whnz-format-wallet { width: 450px; min-height: 280px; border-radius: 16px; flex-direction: row; }\n\n        /* Theme: Bold Gradient */\n        .whnz-theme-google { background: linear-gradient(135deg, var(--brand-color-1) 0%, var(--brand-color-1) 50%, var(--brand-color-2) 50%, var(--brand-color-2) 100%); }\n        .whnz-theme-google .whnz-card-inner { background: #ffffff; margin: 12px; border-radius: 10px; flex: 1; display: flex; position: relative; }\n        .whnz-theme-google.whnz-format-stand .whnz-card-inner { flex-direction: column; padding: 30px 20px; text-align: center; justify-content: space-between; }\n        .whnz-theme-google.whnz-format-wallet .whnz-card-inner { flex-direction: row; padding: 25px; align-items: center; justify-content: space-between; }\n\n        .whnz-card-header { display: flex; flex-direction: column; align-items: center; }\n        .whnz-format-wallet .whnz-card-header { flex: 1; padding-right: 20px; text-align: center; }\n\n        .whnz-g-logo { display: flex; justify-content: center; margin-bottom: 10px; width: 100%; }\n        .whnz-g-logo svg { width: 45px; height: 45px; flex-shrink: 0; }\n        .whnz-stars { color: var(--g-yellow); font-size: 24px; letter-spacing: 2px; line-height: 1; margin-bottom: 10px; }\n        .whnz-card-headline { font-size: 20px; font-weight: 800; margin: 0 0 10px 0; line-height: 1.2; text-transform: uppercase; color: #202124; word-wrap: break-word; font-family: 'Poppins', sans-serif; }\n\n        .whnz-qr-section { display: flex; flex-direction: column; align-items: center; justify-content: center; }\n        .whnz-format-wallet .whnz-qr-section { border-left: 2px dashed #e2e8f0; padding-left: 25px; height: 100%; }\n\n        .whnz-scan-me { font-weight: 800; font-size: 16px; color: #202124; margin-bottom: 8px; display: flex; align-items: center; gap: 5px; }\n        .whnz-qr-box { background: #ffffff; padding: 10px; border-radius: 8px; border: 2px solid #e8eaed; display: inline-block; }\n\n        .whnz-card-business { font-size: 13px; font-weight: 700; color: #5f6368; text-align: center; padding: 0 10px; box-sizing: border-box; word-wrap: break-word; line-height: 1.3; }\n        .whnz-format-stand .whnz-card-business { margin-top: 20px; }\n        .whnz-format-wallet .whnz-card-business { margin-top: 15px; }\n\n        /* Theme: Clean Minimal */\n        .whnz-theme-minimal { background: #ffffff; border: 1px solid #e2e8f0; }\n        .whnz-theme-minimal .whnz-card-inner { width: 100%; height: 100%; display: flex; margin: 0;}\n        .whnz-theme-minimal.whnz-format-stand .whnz-card-inner { flex-direction: column; padding: 40px 20px; text-align: center; align-items: center; justify-content: space-between;}\n        .whnz-theme-minimal.whnz-format-wallet .whnz-card-inner { flex-direction: row; padding: 30px; align-items: center; justify-content: space-between;}\n        .whnz-theme-minimal .whnz-g-logo { display: none; }\n        .whnz-theme-minimal .whnz-card-headline { color: var(--whnz-cyan-dark); }\n        .whnz-theme-minimal .whnz-stars { color: #cbd5e1; }\n\n        /* Generator Button */\n        .whnz-btn {\n            background: var(--whnz-cyan); color: #ffffff; border: none; padding: 16px 30px;\n            font-size: 15px; font-weight: 600; border-radius: 10px; cursor: pointer; transition: all 0.3s ease;\n            width: 100%; margin-top: 25px; display: flex; justify-content: center; align-items: center; gap: 10px;\n            box-shadow: 0 4px 10px rgba(12, 192, 223, 0.2);\n            font-family: 'Poppins', sans-serif;\n        }\n        .whnz-btn:hover { background: var(--whnz-cyan-dark); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(12, 192, 223, 0.3); }\n\n        /* --- HOW IT WORKS (STEPS) --- */\n        .whnz-steps-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 30px;\n            margin-bottom: 80px;\n        }\n        .whnz-step-card {\n            background: #fff;\n            border: 1px solid #e2e8f0;\n            padding: 30px;\n            border-radius: 16px;\n            text-align: center;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.02);\n            transition: transform 0.3s ease;\n        }\n        .whnz-step-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.06); }\n        .whnz-step-icon {\n            width: 60px; height: 60px;\n            background: rgba(12, 192, 223, 0.1);\n            color: var(--whnz-cyan);\n            font-size: 24px; font-weight: 800;\n            border-radius: 50%;\n            display: flex; align-items: center; justify-content: center;\n            margin: 0 auto 20px;\n        }\n        .whnz-step-card h3 { font-size: 18px; color: #0b1220; margin-bottom: 10px; font-weight: 700; }\n        .whnz-step-card p { font-size: 14px; color: #475569; margin: 0; }\n\n        /* --- BENEFITS SECTION --- */\n        .whnz-benefits-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 25px;\n            margin-bottom: 80px;\n        }\n        .whnz-benefit-item {\n            background: #fff;\n            padding: 30px;\n            border-radius: 16px;\n            border: 1px solid #e2e8f0;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.02);\n            transition: transform 0.3s ease;\n        }\n        .whnz-benefit-item:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); }\n        .whnz-benefit-item h3 { font-size: 18px; color: #0b1220; margin-top: 0; margin-bottom: 10px; font-weight: 700; }\n        .whnz-benefit-item p { font-size: 14px; color: #475569; margin: 0; }\n\n        /* --- FAQ SECTION --- */\n        .whnz-faq-section { max-width: 900px; margin: 0 auto 50px; }\n        .whnz-faq-item {\n            background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 15px;\n            box-shadow: 0 2px 5px rgba(0,0,0,0.02); overflow: hidden;\n        }\n        .whnz-faq-question {\n            font-weight: 700; font-size: 15px; color: #0b1220; cursor: pointer;\n            padding: 20px; display: flex; justify-content: space-between; align-items: center;\n        }\n        .whnz-faq-answer {\n            font-size: 14px; color: #475569; padding: 0 20px 20px; display: none; line-height: 1.6;\n        }\n        .whnz-faq-question.active + .whnz-faq-answer { display: block; }\n        .whnz-faq-question::after { \n            content: ''; display: inline-block; width: 10px; height: 10px;\n            border-right: 2px solid #94a3b8; border-bottom: 2px solid #94a3b8;\n            transform: rotate(45deg); transition: transform 0.3s ease; margin-top: -5px;\n        }\n        .whnz-faq-question.active::after { transform: rotate(-135deg); margin-top: 5px; }\n\n        /* Google API fix */\n        .pac-container { z-index: 999999 !important; border-radius: 8px; border: none; font-family: 'Poppins', sans-serif; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }\n        .pac-item { padding: 10px; font-size: 13px; cursor: pointer; }\n\n        /* --- RESPONSIVE MEDIA QUERIES --- */\n        @media (max-width: 900px) {\n            .whnz-hero-wrapper { \n                /* Force Mobile Padding Fix */\n                padding: 280px 20px 40px 20px !important; \n                margin-top: -150px;\n            }\n            .whnz-hero { flex-direction: column; text-align: center; gap: 40px; padding: 0; }\n            .whnz-hero-content h1 { font-size: 42px; }\n            .whnz-hero-content p { max-width: 100%; margin-left: auto; margin-right: auto; }\n            .whnz-hero-buttons { justify-content: center; }\n            \n            .whnz-qr-wrapper { grid-template-columns: 1fr; padding: 25px; }\n            \n            .whnz-format-wallet { width: 100%; max-width: 380px; height: auto; flex-direction: column; }\n            .whnz-format-wallet .whnz-card-inner { flex-direction: column; }\n            .whnz-format-wallet .whnz-qr-section { border-left: none; border-top: 2px dashed #e2e8f0; padding-left: 0; padding-top: 20px; margin-top: 20px; }\n            \n            .whnz-steps-grid { grid-template-columns: 1fr; }\n            .whnz-benefits-grid { grid-template-columns: 1fr; }\n        }\n        @media (max-width: 480px) {\n            .whnz-hero-content h1 { font-size: 34px; }\n            .whnz-hero-buttons { flex-direction: column; width: 100%; }\n            .whnz-btn-primary, .whnz-btn-secondary { width: 100%; }\n            .whnz-row-2 { grid-template-columns: 1fr; }\n        }\n    </style>\n\n    <div class=\"whnz-landing-page\">\n\n        <div class=\"whnz-hero-wrapper\">\n            <div class=\"whnz-hero\">\n                <div class=\"whnz-hero-content\">\n                    <span class=\"whnz-hero-overline\">WEBHOSTING NZ TOOLS</span>\n                    <h1>Double Your Google Reviews<br><span>Instantly.</span></h1>\n                    <p>Create a custom, print-ready Google Review card and QR code for your business in seconds. Build instant trust with potential customers and dominate local search results.</p>\n                    <div class=\"whnz-hero-buttons\">\n                        <a href=\"#whnz-generator-tool\" class=\"whnz-btn-primary\">View Generator</a>\n                        <a href=\"#whnz-how-it-works\" class=\"whnz-btn-secondary\">How it works</a>\n                    </div>\n                </div>\n                <div class=\"whnz-hero-image\">\n                    <img decoding=\"async\" src=\"https://webhosting.co.nz/wp-content/uploads/2026/05/Free-Google-Review-QR-Code-Generator-2.png\" alt=\"Free Google Review QR Code Generator Cards\">\n                </div>\n            </div>\n        </div>\n\n        <div class=\"whnz-tool-container\">\n            \n            <div id=\"whnz-generator-tool\" class=\"whnz-qr-wrapper\">\n                <div class=\"whnz-controls\">\n                    <h3 style=\"margin-top:0; color:var(--whnz-text); font-size: 20px;\">1. Find Your Business</h3>\n                    \n                    <div class=\"whnz-control-group\">\n                        <label for=\"whnz-search\">Search Business on Google</label>\n                        <input type=\"text\" id=\"whnz-search\" placeholder=\"Start typing your business name...\">\n                        <div class=\"whnz-error-msg\" id=\"whnz-search-error\">Please select a business from the dropdown.</div>\n                    </div>\n\n                    <div class=\"whnz-control-group\">\n                        <label for=\"whnz-manual-url\">Or Paste Google Review URL Manually</label>\n                        <input type=\"text\" id=\"whnz-manual-url\" placeholder=\"https://search.google.com/local/writereview?placeid=...\">\n                    </div>\n\n                    <div class=\"whnz-divider\"></div>\n\n                    <h3 style=\"margin: 10px 0 0 0; color:var(--whnz-text); font-size: 20px;\">2. Customize Layout</h3>\n\n                    <div class=\"whnz-row-2\">\n                        <div class=\"whnz-control-group\">\n                            <label for=\"whnz-input-format\">Download Format Size</label>\n                            <select id=\"whnz-input-format\">\n                                <option value=\"whnz-format-stand\">Counter Stand (Portrait)</option>\n                                <option value=\"whnz-format-wallet\">Wallet Card (Landscape)</option>\n                            </select>\n                        </div>\n                        <div class=\"whnz-control-group\">\n                            <label for=\"whnz-input-theme\">Design Style</label>\n                            <select id=\"whnz-input-theme\">\n                                <option value=\"whnz-theme-google\">Bold Brand Colors</option>\n                                <option value=\"whnz-theme-minimal\">Clean Minimal</option>\n                            </select>\n                        </div>\n                    </div>\n\n                    <div class=\"whnz-row-2\">\n                        <div class=\"whnz-control-group\">\n                            <label for=\"whnz-input-color-1\">Border Color 1</label>\n                            <div class=\"whnz-color-picker\">\n                                <input type=\"color\" id=\"whnz-input-color-1\" value=\"#EA4335\">\n                            </div>\n                        </div>\n                        <div class=\"whnz-control-group\">\n                            <label for=\"whnz-input-color-2\">Border Color 2</label>\n                            <div class=\"whnz-color-picker\">\n                                <input type=\"color\" id=\"whnz-input-color-2\" value=\"#34A853\">\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"whnz-control-group\">\n                        <label for=\"whnz-input-headline\">Headline</label>\n                        <input type=\"text\" id=\"whnz-input-headline\" value=\"TAP TO REVIEW US ON GOOGLE\">\n                    </div>\n\n                    <div class=\"whnz-control-group\">\n                        <label for=\"whnz-input-business-name\">Business Name on Card (Edit if needed)</label>\n                        <input type=\"text\" id=\"whnz-input-business-name\" value=\"Your Business Name\">\n                    </div>\n                </div>\n\n                <div class=\"whnz-preview-section\">\n                    \n                    <div class=\"whnz-card-container whnz-theme-google whnz-format-stand\" id=\"whnz-card-export\">\n                        <div class=\"whnz-card-inner\">\n                            \n                            <div class=\"whnz-card-header\">\n                                <div class=\"whnz-g-logo\">\n                                    <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\"/>\n                                        <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"/>\n                                        <path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\" fill=\"#FBBC05\"/>\n                                        <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" fill=\"#EA4335\"/>\n                                    </svg>\n                                </div>\n                                <div class=\"whnz-stars\">\u2605\u2605\u2605\u2605\u2605</div>\n                                <h2 class=\"whnz-card-headline\" id=\"whnz-display-headline\">TAP TO REVIEW US ON GOOGLE</h2>\n                            </div>\n\n                            <div class=\"whnz-qr-section\">\n                                <div class=\"whnz-scan-me\">\n                                    SCAN ME\n                                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg>\n                                </div>\n                                <div class=\"whnz-qr-box\">\n                                    <div id=\"whnz-qr-canvas\"></div>\n                                </div>\n                                <div class=\"whnz-card-business\" id=\"whnz-display-business\">Your Business Name</div>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <button class=\"whnz-btn\" id=\"whnz-download-btn\" onclick=\"whnzDownloadCard()\">\n                        <svg width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"></line></svg>\n                        Download High-Res Print File\n                    </button>\n                </div>\n            </div>\n\n            <div id=\"whnz-how-it-works\" class=\"whnz-section-header\" style=\"scroll-margin-top: 100px;\">\n                <h2>How to Generate Your Code</h2>\n                <p>Three simple steps to create professional review materials for your business counter or wallet.</p>\n            </div>\n            \n            <div class=\"whnz-steps-grid\">\n                <div class=\"whnz-step-card\">\n                    <div class=\"whnz-step-icon\">1</div>\n                    <h3>Search Your Business</h3>\n                    <p>Use the Google Autocomplete search bar above to locate your official Google Business Profile. We automatically grab the correct Place ID.</p>\n                </div>\n                <div class=\"whnz-step-card\">\n                    <div class=\"whnz-step-icon\">2</div>\n                    <h3>Customize the Design</h3>\n                    <p>Select your preferred card layout, choose your brand colors, and edit the headline to perfectly match your store's aesthetic.</p>\n                </div>\n                <div class=\"whnz-step-card\">\n                    <div class=\"whnz-step-icon\">3</div>\n                    <h3>Download & Print</h3>\n                    <p>Click download to receive a massive, high-resolution PNG file ready to be printed at home, the office, or sent to a professional print shop.</p>\n                </div>\n            </div>\n\n            <div class=\"whnz-section-header\">\n                <h2>Why Google Reviews Matter</h2>\n                <p>Reviews are the backbone of modern local marketing. Stop hoping customers leave a review and start actively collecting them.</p>\n            </div>\n\n            <div class=\"whnz-benefits-grid\">\n                <div class=\"whnz-benefit-item\">\n                    <h3>Boost Local SEO</h3>\n                    <p>Google Maps prioritizes businesses with high review counts and positive ratings. More 5-star reviews directly push your business to the top of local search results.</p>\n                </div>\n                <div class=\"whnz-benefit-item\">\n                    <h3>Remove Friction</h3>\n                    <p>Typing out a business name and finding the review button is tedious. A scannable QR code takes your customer exactly to the review page in a single second.</p>\n                </div>\n                <div class=\"whnz-benefit-item\">\n                    <h3>Build Instant Trust</h3>\n                    <p>Did you know over 90% of consumers read local reviews before visiting? A high star rating is the ultimate social proof that your services are reliable.</p>\n                </div>\n                <div class=\"whnz-benefit-item\">\n                    <h3>Professional Appearance</h3>\n                    <p>Our custom generator ensures your review requests don't look like cheap printouts. Provide a premium experience at your cashier desk or restaurant tables.</p>\n                </div>\n            </div>\n\n            <div class=\"whnz-section-header\">\n                <h2>Frequently Asked Questions</h2>\n            </div>\n            \n            <div class=\"whnz-faq-section\">\n                <div class=\"whnz-faq-item\">\n                    <div class=\"whnz-faq-question\" onclick=\"this.classList.toggle('active')\">Is this QR code generator completely free?</div>\n                    <div class=\"whnz-faq-answer\">Yes! WebHosting NZ provides this tool entirely for free. There are no hidden fees, subscriptions, or watermarks on your downloaded file.</div>\n                </div>\n\n                <div class=\"whnz-faq-item\">\n                    <div class=\"whnz-faq-question\" onclick=\"this.classList.toggle('active')\">Do these QR codes ever expire?</div>\n                    <div class=\"whnz-faq-answer\">No, your generated QR code is static and directly linked to your official Google Place ID. As long as your Google Business Profile remains active, the QR code will work forever.</div>\n                </div>\n\n                <div class=\"whnz-faq-item\">\n                    <div class=\"whnz-faq-question\" onclick=\"this.classList.toggle('active')\">How do I print the downloaded card?</div>\n                    <div class=\"whnz-faq-answer\">The tool exports your design as a high-resolution PNG file. You can easily print this at home, take it to a local print shop, or upload it to online printing services for professional rigid cardstock or acrylic stands.</div>\n                </div>\n\n                <div class=\"whnz-faq-item\">\n                    <div class=\"whnz-faq-question\" onclick=\"this.classList.toggle('active')\">Why isn't my business showing up in the search?</div>\n                    <div class=\"whnz-faq-answer\">Your business must have an active and verified Google Business Profile to appear. If it still doesn't show, you can manually grab your review link from your Google Dashboard and paste it into the \"Manual URL\" field above.</div>\n                </div>\n            </div>\n\n        </div> </div> \n\n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<footer data-elementor-type=\"footer\" data-elementor-id=\"4117\" class=\"elementor elementor-4117 elementor-location-footer\" data-elementor-post-type=\"elementor_library\">\n\t\t\t<div class=\"elementor-element elementor-element-667e98d5 e-flex e-con-boxed e-con e-parent\" data-id=\"667e98d5\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-eleme