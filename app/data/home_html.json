font-weight: 700;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: #0CC0DF;\n            display: block;\n            margin-bottom: 12px;\n        }\n\n        .whnz2-btn {\n            background: #0CC0DF;\n            color: #ffffff !important;\n            text-decoration: none !important;\n            padding: 16px 36px;\n            border-radius: 10px;\n            font-family: 'Outfit', sans-serif;\n            font-weight: 700;\n            font-size: 13px;\n            letter-spacing: 0.05em;\n            text-transform: uppercase;\n            display: inline-block;\n            transition: all 0.3s ease;\n            border: none;\n            cursor: pointer;\n            box-shadow: 0 8px 24px rgba(12, 192, 223, 0.3);\n        }\n        .whnz2-btn:hover {\n            background: #09aecb;\n            box-shadow: 0 12px 32px rgba(12, 192, 223, 0.4);\n            transform: translateY(-2px);\n        }\n\n        .whnz2-btn-dark {\n            background: #0a0f1e;\n            color: #ffffff !important;\n            text-decoration: none !important;\n            padding: 16px 36px;\n            border-radius: 10px;\n            font-family: 'Outfit', sans-serif;\n            font-weight: 700;\n            font-size: 13px;\n            letter-spacing: 0.05em;\n            text-transform: uppercase;\n            display: inline-block;\n            transition: all 0.3s ease;\n            border: none;\n            cursor: pointer;\n            box-shadow: 0 8px 24px rgba(10, 15, 30, 0.2);\n        }\n        .whnz2-btn-dark:hover {\n            background: #000000;\n            box-shadow: 0 12px 32px rgba(10, 15, 30, 0.3);\n            transform: translateY(-2px);\n        }\n\n        .whnz2-center-head {\n            text-align: center;\n            margin-bottom: 60px;\n        }\n        .whnz2-center-head h2 {\n            font-size: clamp(30px, 4vw, 42px);\n        }\n        .whnz2-grid-4 {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 20px;\n        }\n        .whnz2-sol-card {\n            background: #ffffff;\n            border: 1px solid #eaedf3;\n            border-radius: 16px;\n            padding: 40px 30px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.02);\n            transition: all 0.3s ease;\n            height: 100%; /* EQUAL HEIGHT FIX */\n        }\n        .whnz2-sol-card:hover {\n            border-color: #0CC0DF;\n            box-shadow: 0 10px 30px rgba(12, 192, 223, 0.1);\n            transform: translateY(-5px);\n        }\n        .whnz2-sol-ico {\n            width: 40px; height: 40px;\n            background: rgba(12, 192, 223, 0.1);\n            color: #000000;\n            border-radius: 10px;\n            display: flex; align-items: center; justify-content: center;\n            margin-bottom: 20px;\n        }\n        .whnz2-sol-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2;}\n        .whnz2-sol-card h4 {\n            font-size: 18px;\n            margin-bottom: 12px;\n        }\n        .whnz2-sol-card p {\n            font-size: 14px;\n            color: #5a6478;\n        }\n\n        .whnz2-banner-wrapper {\n            padding: 40px 40px;\n            max-width: 1280px;\n            margin: 0 auto;\n        }\n        .whnz2-banner {\n            background: #0CC0DF; \n            border-radius: 20px;\n            padding: 50px 60px;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 40px;\n            color: #ffffff;\n        }\n        .whnz2-banner-text {\n            flex: 1;\n        }\n        .whnz2-banner h3 {\n            color: #ffffff;\n            font-size: 28px;\n            margin-bottom: 15px;\n        }\n        .whnz2-banner p {\n            color: #ffffff;\n            opacity: 0.95;\n            font-size: 15px;\n            margin-bottom: 2