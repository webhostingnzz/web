"\n    (function(){\n        const uid = \"whnz_nav_wrapper\";\n        const root = document.querySelector('.' + uid + '[data-whnz-nav]');\n        if(!root) return;\n\n        const burger = root.querySelector('.whnz-burger');\n        const mobile = root.querySelector('.whnz-mobile');\n        const toggle = root.querySelector('[data-whnz-toggle=\"hosting\"]');\n        const sub = root.querySelector('[data-whnz-sub=\"hosting\"]');\n\n        function openMenu(){\n            mobile.classList.add('open');\n            burger.classList.add('is-open');\n            burger.setAttribute('aria-expanded', 'true');\n        }\n        function closeMenu(){\n            mobile.classList.remove('open');\n            burger.classList.remove('is-open');\n            burger.setAttribute('aria-expanded', 'false');\n        }\n\n        if(burger && mobile){\n            burger.addEventListener('click', (e) => {\n                e.preventDefault(); e.stopPropagation();\n                mobile.classList.contains('open') ? closeMenu() : openMenu();\n            });\n        }\n\n        if(toggle && sub){\n            toggle.addEventListener('click', (e) => {\n                e.preventDefault();\n                sub.classList.toggle('open');\n            });\n        }\n\n        document.addEventListener('click', (e) => {\n            if(window.innerWidth > 980) return;\n            if(!mobile.classList.contains('open')) return;\n            if(root.contains(e.target)) return;\n            closeMenu();\n        });\n\n        // Desktop Mega Menu\n        const trigger = root.querySelector('[data-whnz-trigger=\"hosting\"]');\n        const mega = document.querySelector('.' + uid + '-mega[data-whnz-mega=\"hosting\"]');\n        let megaOpen = false;\n        let closeTimer = null;\n\n        function positionMega(){\n            if(!trigger || !mega) return;\n            const r = trigger.getBoundingClientRect();\n            const megaWidth = mega.offsetWidth || 640;\n            const margin = 16;\n            let left = r.left + (r.width / 2) - (megaWidth / 2);\n            left = Math.max(margin, Math.min(left, window.innerWidth - megaWidth - margin));\n            mega.style.left = left + 'px';\n            mega.style.top = (r.bottom + 12) + 'px';\n        }\n\n        function openMega(){\n            if(!mega) return;\n            clearTimeout(closeTimer);\n            positionMega();\n            mega.classList.add('open');\n            trigger.classList.add('is-active');\n            trigger.setAttribute('aria-expanded', 'true');\n            megaOpen = true;\n        }\n        function closeMega(){\n            if(!mega) return;\n            mega.classList.remove('open');\n            trigger.classList.remove('is-active');\n            trigger.setAttribute('aria-expanded', 'false');\n            megaOpen = false;\n        }\n        function scheduleClose(){\n            clearTimeout(closeTimer);\n            closeTimer = setTimeout(closeMega, 150);\n        }\n\n        if(trigger && mega){\n            trigger.addEventListener('mouseenter', () => { if(window.innerWidth > 980) openMega(); });\n            trigger.addEventListener('mouseleave', () => { if(window.innerWidth > 980) scheduleClose(); });\n            mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));\n            mega.addEventListener('mouseleave', scheduleClose);\n\n            trigger.addEventListener('click', (e) => {\n                e.preventDefault();\n                megaOpen ? closeMega() : openMega();\n            });\n\n            window.addEventListener('resize', () => { if(megaOpen) positionMega(); });\n            window.addEventListener('scroll', () => { if(megaOpen) positionMega(); }, { passive: true });\n\n            document.addEventListener('click', (e) => {\n                if(root.contains(e.target) || mega.contains(e.target)) return;\n                closeMega();\n            });\n        }\n\n        // Trigger card background appearance when scrolled down past 20px\n        window.addEventListener('scroll', () => {\n            root.classList.toggle('scrolled', window.pageYOffset > 20);\n        }, { passive: true });\n    })();\n    \n\n\n(function() {\n    // 1. General Reveal Animation\n    const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n                entry.target.classList.add('visible');\n            }\n        });\n    }, { threshold: 0.1 });\n    document.querySelectorAll('.whnz_modern_4456 .scroll-trigger').forEach(el => observer.observe(el));\n\n    // 2. Timeline Logic\n    const stepObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n                entry.target.classList.add('active');\n            } else {\n                entry.target.classList.remove('active');\n            }\n        });\n    }, { rootMargin: '-20% 0px -20% 0px', threshold: 0.5 });\n    document.querySelectorAll('.whnz_modern_4456 .step-trigger').forEach(el => stepObserver.observe(el));\n\n    // 3. Smooth Scroll\n    document.querySelectorAll('.whnz_modern_4456 a[href^=\"#\"]').forEach(anchor => {\n        anchor.addEventListener('click', function (e) {\n            e.preventDefault();\n            const target = document.querySelector(this.getAttribute('href'));\n            if(target) target.scrollIntoView({ behavior: 'smooth' });\n        });\n    });\n})();\n"