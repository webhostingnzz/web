domain.indexOf('.');\n            if (dot === -1) {\n                return { sld: domain, tld: '.com' };\n            }\n\n            return {\n                sld: domain.slice(0, dot),\n                tld: domain.slice(dot)\n            };\n        }\n\n        function rowId(domain) {\n            return 'row_' + domain.replace(/[^a-z0-9]/g, '_');\n        }\n\n        function escapeHtml(text) {\n            return $('<div>').text(text).html();\n        }\n\n        function fireAjaxCheck(domainToCheck, actionType, isMain) {\n            const id = rowId(domainToCheck);\n            const mainClass = isMain ? ' nxt-main-result' : '';\n\n            const loadingHtml =\n                '<div id=\"' + id + '\" class=\"nxt-result-row nxt-row-wait' + mainClass + '\">' +\n                '<span>Checking <b>' + escapeHtml(domainToCheck) + '</b>...</span>' +\n                '<span class=\"nxt-status-btn nxt-btn-wait\"><span class=\"nxt-spinner\"></span> WAIT</span>' +\n                '</div>';\n\n            if (isMain) {\n                $('#nxt_results').prepend(loadingHtml);\n            } else {\n                $('#nxt_results').append(loadingHtml);\n            }\n\n            $.ajax({\n                url: ajaxUrl,\n                type: 'POST',\n                dataType: 'json',\n                timeout: 25000,\n                data: {\n                    action: 'nxt_check_domain_whmcs',\n                    security: nonce,\n                    domain: domainToCheck\n                },\n                success: function(response) {\n                    let html = '';\n                    const safeDomain = escapeHtml(domainToCheck);\n                    const regLink = 'https://my.webhosting.co.nz/cart.php?a=add&domain=register&query=' + encodeURIComponent(domainToCheck);\n                    const transLink = 'https://my.webhosting.co.nz/cart.php?a=add&domain=transfer&query=' + encodeURIComponent(domainToCheck);\n\n                    if (response && response.success && response.data && response.data.status === 'available') {\n                        if (actionType === 'transfer') {\n                            // An \"available\" domain (not registered anywhere) cannot be\n                            // transferred - there's nothing to transfer. Tell the user\n                            // clearly instead of showing a misleading Transfer button.\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                                '<span>\u2716 <b>' + safeDomain + '</b> is not registered, so it can\\'t be transferred. You can register it instead.</span>' +\n                                '<a href=\"' + regLink + '\" class=\"nxt-status-btn nxt-btn-buy\">REGISTER</a>' +\n                                '</div>';\n                        } else {\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-avail' + mainClass + '\">' +\n                                '<span><b>' + safeDomain + '</b> is available!</span>' +\n                                '<a href=\"' + regLink + '\" class=\"nxt-status-btn nxt-btn-buy\">BUY NOW</a>' +\n                                '</div>';\n                        }\n                    } else if (response && response.success && response.data && response.data.status === 'unavailable') {\n                        if (actionType === 'transfer') {\n                            // FIX: a registered domain is exactly what CAN be transferred.\n                            // Previously this branch always showed \"TAKEN\" regardless of\n                            // actionType, which made the Transfer button unusable.\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-avail' + mainClass + '\">' +\n                                '<span>Ready to transfer <b>' + safeDomain + '</b>?</span>' +\n                                '<a href=\"' + transLink + '\" class=\"nxt-status-btn nxt-btn-buy\">TRANSFER</a>' +\n                                '</div>';\n                        } else {\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                                '<span>\u2716 Sorry! <b>' + safeDomain + '</b> is already taken.</span>' +\n                                '<span class=\"nxt-status-btn nxt-btn-err\">TAKEN</span>' +\n                                '</div>';\n                        }\n                    } else {\n                        const msg = response && response.data && response.data.message ? response.data.message : 'Lookup failed';\n                        html =\n                            '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                            '<span>\u2716 <b>' + safeDomain + '</b>: ' + escapeHtml(msg) + '</span>' +\n                            '<span class=\"nxt-status-btn nxt-btn-err\">CHECK FAILED</span>' +\n                            '</div>';\n                    }\n\n                    $('#' + id).replaceWith(html);\n                },\n                error: function() {\n                    $('#' + id).replaceWith(\n                        '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                        '<span>\u2716 Server connection failed for <b>' + escapeHtml(domainToCheck) + '</b></span>' +\n                        '<span class=\"nxt-status-btn nxt-btn-err\">ERROR</span>' +\n                        '</div>'\n                    );\n                }\n            });\n        }\n\n        function initiateSearch(actionType) {\n            let inputVal = cleanDomain($('#nxt_domain_name').val());\n\n            if (!inputVal) {\n                alert('Please enter a domain name.');\n                return;\n            }\n\n            let parts = splitDomain(inputVal);\n            let baseName = parts.sld;\n            let mainExt = parts.tld;\n\n            if (!baseName || baseName.length < 2) {\n                alert('Please enter a valid domain name.');\n                return;\n            }\n\n            const mainDomain = baseName + mainExt;\n\n            $('#nxt_results').html('');\n            $('.nxt-btn').prop('disabled', true);\n\n            fireAjaxCheck(mainDomain, actionType, true);\n\n            if (actionType === 'search') {\n                const suggestions = suggestionExtensions\n                    .filter(tld => tld !== mainExt)\n                    .map(tld => baseName + tld);\n\n                suggestions.forEach(function(domain, index) {\n                    setTimeout(function() {\n                        fireAjaxCheck(domain, 'search', false);\n\n                        if (index === suggestions.length - 1) {\n                            setTimeout(function() {\n                                $('.nxt-btn').prop('disabled', false);\n                            }, 800);\n                        }\n                    }, 300 * (index + 1));\n                });\n            } else {\n                setTimeout(function() {\n                    $('.nxt-btn').prop('disabled', false);\n                }, 800);\n            }\n        }\n\n        $('#btn_search').on('click', function(e) {\n            e.preventDefault();\n            initiateSearch('search');\n        });\n\n        $('#btn_transfer').on('click', function(e) {\n            e.preventDefault();\n            initiateSearch('transfer');\n        });\n\n        $('#nxt_domain_name').on('keypress', function(e) {\n            if (e.which === 13) {\n                e.preventDefault();\n                initiateSearch('search');\n            }\n        });\n    });\n    "