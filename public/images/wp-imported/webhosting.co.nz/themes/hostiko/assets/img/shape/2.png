        /* Set base background to match Webhosting NZ's brand color to prevent flashes */
        html {
            background-color: #0f172a !important; /* Update this hex code to match your site's primary background */
        }
        
        /* Hide the body content for a split second to let CSS catch up, then fade in */
        body {
            opacity: 0;
            animation: whnzSmoothFade 0.6s ease-in-out forwards;
            animation-delay: 0.3s; /* Gives the builder 0.3 seconds to load styles invisibly */
        }

        @keyframes whnzSmoothFade {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
    </style>
    
