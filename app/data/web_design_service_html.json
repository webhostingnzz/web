{ margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--wh-text-light); }\n    .whnz_modern_4456 ul.checks li svg { width: 20px; height: 20px; color: var(--wh-primary); flex-shrink: 0; }\n\n    /* PROCESS */\n    .whnz_modern_4456 .process-line-container { position: relative; max-width: 800px; margin: 0 auto; }\n    .whnz_modern_4456 .process-line-container::before {\n        content: ''; position: absolute; left: 20px; top: 0; bottom: 0; width: 2px; background: #e2e8f0;\n    }\n    .whnz_modern_4456 .step-item { position: relative; padding-left: 60px; margin-bottom: 3rem; opacity: 0.3; transition: opacity 0.5s ease; }\n    .whnz_modern_4456 .step-item.active { opacity: 1; }\n    .whnz_modern_4456 .step-number {\n        position: absolute; left: 0; top: 0; width: 40px; height: 40px; background: white;\n        border: 2px solid #e2e8f0; border-radius: 50%;\n        display: flex; align-items: center; justify-content: center;\n        font-weight: 800; color: var(--wh-text-light); z-index: 2; transition: all 0.3s ease;\n    }\n    .whnz_modern_4456 .step-item.active .step-number {\n        border-color: var(--wh-primary); background: var(--wh-primary);\n        color: white; transform: scale(1.2); box-shadow: 0 0 20px rgba(12, 192, 223, 0.4);\n    }\n\n    /* CTA */\n    .whnz_modern_4456 .cta-box {\n        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);\n        border-radius: 30px; padding: 4rem 2rem; text-align: center; color: white;\n        box-shadow: 0 20px 60px rgba(0,0,0,0.2); overflow: hidden; position: relative;\n    }\n    .whnz_modern_4456 .cta-box::before {\n        content: ''; position: absolute; top: -50%; left: -20%; width: 500px; height: 500px;\n        background: radial-gradient(circle, rgba(12,192,223,0.2) 0%, transparent 70%);\n        border-radius: 50%; pointer-events: none;\n    }\n    .whnz_modern_4456 .cta-box h2 { color: white; margin-bottom: 1rem; }\n    .whnz_modern_4456 .cta-box p { color: #9