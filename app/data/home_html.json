                                     <img src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/2.webp\" alt=\"Web Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Web Hosting</h4>\n                        <p>Fast &amp; affordable hosting</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/wordpress-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/4.webp\" alt=\"WordPress Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>WordPress Hosting</h4>\n                        <p>Optimized for WordPress</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/website-builder-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2026/02/5.webp\" alt=\"Website Builder Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Website Builder Hosting</h4>\n                        <p>Build a site easily</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/cloud-servers\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/1.webp\" alt=\"Cloud Servers\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Cloud Servers</h4>\n                        <p>Scale when you grow</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/vps-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2025/11/3.webp\" alt=\"VPS Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>VPS Hosting</h4>\n                        <p>Dedicated resources</p>\n                    </span>\n                </a>\n                    </div>\n    </div>\n\n    \n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</header>\n\t\t\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"2259\" class=\"elementor elementor-2259\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4c525ac e-con-full e-flex e-con e-parent\" data-id=\"4c525ac\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-527d264 elementor-widget elementor-widget-shortcode\" data-id=\"527d264\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');\n\n        /* Enable smooth scrolling for anchor links */\n        html {\n            scroll-behavior: smooth;\n        }\n\n        .whnz-wrap, .whnz-wrap * { box-sizing: border-box; margin: 0; padding: 0; }\n\n        .whnz-wrap {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            background: #ffffff;\n            overflow-x: hidden;\n            color: #000000;\n        }\n\n        /* \u2500\u2500 START TRANSITIONS (KEEP HERO AS-IS) \u2500\u2500 */\n        @keyframes whnzFadeUp {\n            0% { opacity: 0; transform: translateY(30px); }\n            100% { opacity: 1; transform: translateY(0); }\n        }\n\n        /* ORIGINAL: hero uses this (page-load animation) */\n        .whnz-animate-up {\n            opacity: 0; /* Hidden before animation starts */\n            animation: whnzFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        /* Delays for cascading effect */\n        .whnz-delay-1 { animation-delay: 0.1s; }\n        .whnz-delay-2 { animation-delay: 0.2s; }\n        .whnz-delay-3 { animation-delay: 0.3s; }\n        .whnz-delay-4 { animation-delay: 0.4s; }\n        .whnz-delay-5 { animation-delay: 0.5s; }\n        .whnz-delay-6 { animation-delay: 0.6s; }\n\n        /* NEW: scroll-in animation for WHY + PLANS only */\n        .whnz-animate-scroll {\n            opacity: 0;\n            transform: translateY(30px);\n        }\n        .whnz-animate-scroll.whnz-inview {\n            animation: whnzFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        .whnz-eyebrow {\n            font-family: 'Outfit', sans-serif;\n            font-size: 11px;\n            font-weight: 600;\n            letter-spacing: 0.18em;\n            text-transform: uppercase;\n            color: #0CC0DF;\n            display: block;\n            text-align: center;\n            margin-bottom: 14px;\n        }\n\n        .whnz-heading {\n            font-family: 'Outfit', sans-serif;\n            font-weight: 800;\n            color: #000000;\n            letter-spacing: -0.025em;\n            line-height: 1.08;\n        }\n\n        /* \u2500\u2500 HERO \u2500\u2500 */\n        .whnz-hero {\n            min-height: auto;\n            background: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            overflow: hidden;\n            /* Reduced top padding to move section UP on desktop */\n            padding: 80px 40px 20px;\n        }\n\n        .whnz-hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background-image: radial-gradient(circle, rgba(12,192,223,0.15) 1px, transparent 1px);\n            background-size: 32px 32px;\n            pointer-events: none;\n        }\n\n        .whnz-hero::after {\n            content: '';\n            position: absolute;\n            width: 800px; height: 800px;\n            background: transparent;\n            top: -200px; right: -200px;\n            pointer-events: none;\n        }\n\n        .whnz-hero-inner {\n            max-width: 1280px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 20px;\n            align-items: center;\n            position: relative;\n            z-index: 2;\n            width: 100%;\n        }\n\n        .whnz-hero-left {\n            /* Pushes the text right, closer to the map on desktop */\n            margin-left: 60px;\n        }\n\n        .whnz-hero-tag {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            border: 1.5px solid rgba(12,192,223,0.4);\n            background: rgba(12,192,223,0.05);\n            backdrop-filter: blur(8px);\n            padding: 7px 16px 7px 10px;\n            border-radius: 100px;\n            font-size: 12px;\n            font-weight: 600;\n            color: #000000;\n            margin-bottom: 30px;\n        }\n\n        .whnz-hero-tag i {\n            width: 20px; height: 20px;\n            background: #0CC0DF;\n            border-radius: 50%;\n            display: inline-flex; align-items: center; justify-content: center;\n            color: #ffffff; font-style: normal; font-size: 10px; font-weight: 700;\n        }\n\n        .whnz-hero h1 {\n            font-family: 'Outfit', sans-serif;\n            font-size: clamp(44px, 5vw, 72px);\n            font-weight: 800;\n            color: #000000;\n            letter-spacing: -0.03em;\n            line-height: 1.05;\n            margin-bottom: 22px;\n        }\n\n        .whnz-hero h1 em {\n            font-style: normal;\n            color: #0CC0DF;\n        }\n\n        .whnz-hero-sub {\n            font-size: 17px;\n            color: rgba(0,0,0,0.7);\n            line-height: 1.75;\n            margin-bottom: 44px;\n            font-weight: 400;\n            max-width: 440px;\n        }\n\n        .whnz-cta-row {\n            display: flex;\n            gap: 14px;\n            flex-wrap: wrap;\n            align-items: center;\n        }\n\n        .whnz-btn-solid {\n            background: #0CC0DF;\n            color: #ffffff !important;\n            text-decoration: none !important;\n            padding: 15px 34px;\n            border-radius: 10px;\n            font-weight: 700;\n            font-size: 13px;\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            transition: all 0.25s ease;\n            display: inline-block;\n            box-shadow: 0 4px 24px rgba(12,192,223,0.3);\n        }\n        .whnz-btn-solid:hover {\n            background: #000000;\n            box-shadow: 0 8px 36px rgba(0,0,0,0.45);\n            transform: translateY(-2px);\n        }\n\n        .whnz-btn-ghost {\n            background: transparent;\n            color: #000000 !important;\n            text-decoration: none !important;\n            padding: 14px 34px;\n            border-radius: 10px;\n            font-weight: 600;\n            font-size: 13px;\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            border: 2px solid #000000;\n            transition: all 0.25s ease;\n            display: inline-block;\n        }\n        .whnz-btn-ghost:hover {\n            border-color: #0CC0DF;\n            color: #0CC0DF !important;\n        }\n\n        /* Hero Image Container */\n        .whnz-hero-right {\n            display: flex;\n            justify-content: flex-start;\n            align-items: center;\n            width: 100%;\n            margin-left: -80px; /* Keeps map image horizontally the same */\n        }\n\n        .whnz-hero-img {\n            max-width: 110%;\n            height: auto;\n            aspect-ratio: 1;\n            display: block;\n            mix-blend-mode: multiply;\n        }\n\n        /* \u2500\u2500 LOGO SLIDER (UNDER HERO) \u2500\u2500 */\n        .whnz-logo-slider {\n            width: 100%;\n            padding: 26px 0 10px;\n            position: relative;\n            z-index: 3;\n        }\n\n        .whnz-logo-slider-inner{\n            max-width: 1280px;\n            margin: 0 auto;\n            padding: 0 40px;\n        }\n\n        .whnz-logo-marquee {\n            overflow: hidden;\n            width: 100%;\n            position: relative;\n        }\n\n        .whnz-logo-track {\n            display: flex;\n            width: max-content;\n            gap: 22px;\n            animation: whnz-scroll 28s linear infinite;\n        }\n\n        .whnz-logo-slide {\n            flex: 0 0 auto;\n            width: 180px;\n            height: 70px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: transparent;   /* no card */\n            border: none;              /* no border */\n            box-shadow: none;          /* no glow */\n        }\n\n        .whnz-logo-slide img {\n            max-width: 155px;\n            max-height: 52px;\n            filter: grayscale(100%) brightness(0.55);\n            opacity: 0.85;\n        }\n\n        /* Optional: color on hover */\n        .whnz-logo-slide:hover img {\n            filter: grayscale(0%) brightness(1);\n            opacity: 1;\n        }\n\n        @keyframes whnz-scroll {\n            from { transform: translateX(0); }\n            to   { trans