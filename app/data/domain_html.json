"\n\t\t<header data-elementor-type=\"header\" data-elementor-id=\"4404\" class=\"elementor elementor-4404 elementor-location-header\" data-elementor-post-type=\"elementor_library\">\n\t\t\t<div class=\"elementor-element elementor-element-8575785 e-con-full e-flex e-con e-parent\" data-id=\"8575785\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-02dc3b7 elementor-widget elementor-widget-shortcode\" data-id=\"02dc3b7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">    <style> :root{ --whnz-accent: #0CC0DF; --whnz-ink: #0b1220; --whnz-muted: rgba(11,18,32,.70); --whnz-shadow: 0 18px 60px rgba(11,18,32,.18); } .whnz_nav_wrapper { position: fixed; top: 0; left: 0; right: 0; width: 100%; z-index: 999998; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; pointer-events: none; padding: 16px 20px; transition: padding .35s cubic-bezier(0.4, 0, 0.2, 1); } .whnz_nav_wrapper * { box-sizing: border-box; } .whnz_nav_wrapper a, .whnz_nav_wrapper button { pointer-events: auto; } /* --- HEADER BAR (Transparent at Top) --- */ .whnz_nav_wrapper .whnz-bar { max-width: 1280px; margin: 0 auto; padding: 12px 24px; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; border: 1px solid transparent; border-radius: 16px; box-shadow: none; transition: all .35s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: auto; } /* --- HEADER BAR (Card Appearance on Scroll) --- */ .whnz_nav_wrapper.scrolled .whnz-bar { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(11, 18, 32, 0.08); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); padding: 10px 24px; } .whnz_nav_wrapper .whnz-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; } .whnz_nav_wrapper .whnz-logo { display: flex; align-items: center; flex-shrink: 0; margin-right: auto; text-decoration: none; } .whnz_nav_wrapper .whnz-logo img { height: 42px; width: auto; display: block; transition: height .3s ease; object-fit: contain; } .whnz_nav_wrapper.scrolled .whnz-logo img { height: 36px; } .whnz_nav_wrapper .whnz-nav { display: flex; align-items: center; gap: 8px; } .whnz_nav_wrapper .whnz-link, .whnz_nav_wrapper .whnz-dropbtn { text-decoration: none; color: var(--whnz-ink); font-weight: 700; font-size: 13px; letter-spacing: .5px; padding: 10px 14px; border-radius: 8px; white-space: nowrap; background: transparent; border: none; cursor: pointer; transition: all .15s ease; display: inline-flex; align-items: center; gap: 6px; } .whnz_nav_wrapper .whnz-link:hover, .whnz_nav_wrapper .whnz-dropbtn:hover, .whnz_nav_wrapper .whnz-dropbtn.is-active { background: rgba(12,192,223,.12); color: var(--whnz-accent); } .whnz_nav_wrapper .whnz-caret { width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); display: inline-block; transition: transform .2s ease; margin-bottom: 2px; } .whnz_nav_wrapper .whnz-dropbtn.is-active .whnz-caret { transform: rotate(225deg); margin-bottom: -2px;} .whnz_nav_wrapper .whnz-new-tag { background: linear-gradient(135deg, #ff6b6b, #ff5252); color: #fff; font-size: 9px; font-weight: 900; padding: 2px 6px; border-radius: 4px; line-height: 1; } .whnz_nav_wrapper .whnz-client { background: var(--whnz-accent); color: #fff; padding: 10px 18px; border-radius: 10px; font-weight: 800; font-size: 13px; letter-spacing: .5px; text-decoration: none; white-space: nowrap; box-shadow: 0 4px 14px rgba(12,192,223,.25); transition: transform .2s ease, box-shadow .2s ease; } .whnz_nav_wrapper .whnz-client:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(12,192,223,.35); } /* Mega Menu (Always solid card for legibility) */ .whnz_nav_wrapper-mega { position: fixed; width: min(640px, calc(100vw - 32px)); padding: 16px; background: #ffffff; border: 1px solid rgba(11,18,32,.1); border-radius: 16px; box-shadow: var(--whnz-shadow); opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease, visibility .2s ease; z-index: 999999; pointer-events: none; } .whnz_nav_wrapper-mega.open { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; } .whnz_nav_wrapper-mega .whnz-mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; } .whnz_nav_wrapper-mega .whnz-card { display: flex; gap: 12px; padding: 12px; border-radius: 10px; text-decoration: none; color: var(--whnz-ink); border: 1px solid transparent; transition: all .2s ease; } .whnz_nav_wrapper-mega .whnz-card:hover { border-color: rgba(12,192,223,.3); background: rgba(12,192,223,.04); transform: translateY(-2px); } .whnz_nav_wrapper-mega .whnz-ic { width: 40px; height: 40px; border-radius: 8px; background: rgba(12,192,223,.1); flex: 0 0 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; } .whnz_nav_wrapper-mega .whnz-ic img, .whnz_nav_wrapper .whnz-m-sub .whnz-ic img { width: 24px !important; height: 24px !important; object-fit: contain; max-width: none !important; } .whnz_nav_wrapper-mega .whnz-card h4 { margin: 0; font-size: 13px; font-weight: 800; color: var(--whnz-ink); } .whnz_nav_wrapper-mega .whnz-card p { margin: 2px 0 0; font-size: 11px; color: var(--whnz-muted); } /* Mobile Responsive */ .whnz_nav_wrapper .whnz-burger { display: none; width: 40px; height: 40px; border-radius: 10px; border: 1px solid rgba(11,18,32,.1); background: rgba(255, 255, 255, 0.5); align-items: center; justify-content: center; cursor: pointer; } .whnz_nav_wrapper .whnz-burger span { width: 18px; height: 2px; background: var(--whnz-ink); position: relative; transition: background .15s ease; } .whnz_nav_wrapper .whnz-burger span:before, .whnz_nav_wrapper .whnz-burger span:after { content: \"\"; position: absolute; left: 0; width: 18px; height: 2px; background: var(--whnz-ink); transition: transform .18s ease, top .18s ease; } .whnz_nav_wrapper .whnz-burger span:before { top: -6px; } .whnz_nav_wrapper .whnz-burger span:after { top: 6px; } .whnz_nav_wrapper .whnz-burger.is-open span { background: transparent; } .whnz_nav_wrapper .whnz-burger.is-open span:before { top: 0; transform: rotate(45deg); } .whnz_nav_wrapper .whnz-burger.is-open span:after { top: 0; transform: rotate(-45deg); } .whnz_nav_wrapper .whnz-mobile { display: none; margin-top: 12px; background: #ffffff; border: 1px solid rgba(11,18,32,.1); border-radius: 16px; box-shadow: var(--whnz-shadow); overflow: hidden; } .whnz_nav_wrapper .whnz-mobile.open { display: block; } .whnz_nav_wrapper .whnz-m-item { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; text-decoration: none; color: var(--whnz-ink); font-weight: 800; font-size: 13px; border-top: 1px solid rgba(11,18,32,.06); } .whnz_nav_wrapper .whnz-m-item:first-child { border-top: none; } .whnz_nav_wrapper .whnz-m-sub { display: none; background: rgba(12,192,223,.03); padding: 8px 16px 16px; border-top: 1px solid rgba(11,18,32,.06); } .whnz_nav_wrapper .whnz-m-sub.open { display: block; } .whnz_nav_wrapper .whnz-m-sub a { display: flex; gap: 12px; padding: 10px; margin-top: 6px; border-radius: 8px; text-decoration: none; color: var(--whnz-ink); font-weight: 700; font-size: 13px; align-items: center; } .whnz_nav_wrapper .whnz-m-sub .whnz-ic { width: 32px; height: 32px; flex: 0 0 32px; border-radius: 6px; background: rgba(12,192,223,.1); display: flex; align-items: center; justify-content: center;} .whnz_nav_wrapper .whnz-m-sub small { display: block; color: var(--whnz-muted); font-size: 11px; font-weight: normal; } @media (max-width: 980px) { .whnz_nav_wrapper .whnz-nav, .whnz_nav_wrapper .whnz-client { display: none; } .whnz_nav_wrapper .whnz-burger { display: flex; } .whnz_nav_wrapper-mega { display: none !important; } .whnz_nav_wrapper { padding: 10px 14px; } } </style>\n\n    <div class=\"whnz_nav_wrapper\" data-whnz-nav>\n        <div class=\"whnz-bar\">\n            <div class=\"whnz-row\">\n                <a class=\"whnz-logo\" href=\"/\">\n                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/Black_and_Blue_Modern_Laptop_with_Internet_Technology_Logo__1_-removebg-preview.png\" alt=\"Webhosting NZ Logo\" width=\"160\" height=\"42\">\n                </a>\n\n                <nav class=\"whnz-nav\" aria-label=\"Main menu\">\n                    <button class=\"whnz-dropbtn\" type=\"button\" data-whnz-trigger=\"hosting\" aria-expanded=\"false\">\n                        HOSTING <span class=\"whnz-caret\" aria-hidden=\"true\"></span>\n                    </button>\n\n                    <a class=\"whnz-link\" href=\"/domain\">DOMAIN</a>\n                    <a class=\"whnz-link\" href=\"/business-email-hosting\">BUSINESS EMAIL</a>\n                    <a class=\"whnz-link\" href=\"/web-design-service\">\n                        WEB DESIGN <span class=\"whnz-new-tag\">NEW</span>\n                    </a>\n                    <a class=\"whnz-link\" href=\"/free-google-review-qr-code-generator\">FREE TOOLS</a>\n                    <a class=\"whnz-link\" href=\"https://webhosting.co.nz/blog/\">BLOG</a>\n                    <a class=\"whnz-link\" href=\"/contact\">CONTACT</a>\n                </nav>\n\n                <a class=\"whnz-client\" href=\"https://my.webhosting.co.nz/clientarea.php\">CLIENT AREA</a>\n\n                <button class=\"whnz-burger\" type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\">\n                    <span aria-hidden=\"true\"></span>\n                </button>\n            </div>\n\n            <div class=\"whnz-mobile\" aria-label=\"Mobile menu\">\n                <a class=\"whnz-m-item\" href=\"/web-hosting\" data-whnz-toggle=\"hosting\">\n                    <span>HOSTING</span><span class=\"whnz-caret\" aria-hidden=\"true\">