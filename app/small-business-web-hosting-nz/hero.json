"<style>\n.whnz3-web_hosting-hero {\n    background: radial-gradient(circle at top left, #e8fbfd 0%, #ffffff 60%);\n    background-image: radial-gradient(circle, rgba(12,192,223,0.12) 1px, transparent 1px), radial-gradient(circle at top left, #e8fbfd 0%, #ffffff 60%);\n    background-size: 28px 28px, 100% 100%;\n    margin-top: -100px;\n    padding: 190px 40px 30px;\n}\n.whnz3-web_hosting-inner {\n    max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.25fr;\n    gap: 40px; align-items: center;\n}\n.whnz3-web_hosting-pill-badge {\n    display: inline-flex; align-items: center; gap: 8px; background: #fff;\n    border: 1px solid rgba(12,192,223,0.35); border-radius: 100px; padding: 8px 18px;\n    font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.1em;\n    color: #0b1220; margin-bottom: 24px;\n}\n.whnz3-web_hosting-pill-badge i {\n    width: 18px; height: 18px; border-radius: 50%; background: #0CC0DF; display: inline-flex;\n    align-items: center; justify-content: center;\n}\n.whnz3-web_hosting-pill-badge i::before {\n    content: \"\\2713\";\n    color: #fff;\n    font-style: normal;\n    font-weight: 900;\n    font-size: 11px;\n    line-height: 1;\n}\n.whnz3-web_hosting-h1 {\n    font-family: 'Outfit', sans-serif; font-weight: 800; font-size: clamp(38px, 4.5vw, 60px);\n    line-height: 1.08; color: #0b1220; margin: 0 0 20px;\n}\n.whnz3-web_hosting-h1 span { color: #0CC0DF; }\n.whnz3-web_hosting-desc {\n    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; line-height: 1.7;\n    color: rgba(11,18,32,0.7); max-width: 520px; margin: 0 0 28px;\n}\n.whnz3-web_hosting-pill {\n    display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid rgba(11,18,32,0.12);\n    border-radius: 100px; padding: 8px 16px; font-family: 'Outfit', sans-serif; font-size: 13px;\n    font-weight: 600; color: #0b1220; margin: 0 10px 10px 0;\n}\n.whnz3-web_hosting-pill svg { color: #0CC0DF; }\n.whnz3-web_hosting-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; }\n.whnz3-web_hosting-btn-solid {\n    background: #0CC0DF; color: #fff !important; text-decoration: none !important;\n    padding: 15px 30px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-weight: 700;\n    font-size: 14px; display: inline-flex; align-items: center; gap: 8px;\n    box-shadow: 0 4px 20px rgba(12,192,223,0.3); transition: all 0.2s ease;\n}\n.whnz3-web_hosting-btn-solid:hover { background: #0aa5c0; transform: translateY(-2px); }\n.whnz3-web_hosting-btn-ghost {\n    background: transparent; color: #0b1220 !important; text-decoration: none !important;\n    padding: 14px 28px; border-radius: 10px; border: 2px solid rgba(11,18,32,0.15);\n    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; display: inline-flex;\n    align-items: center; transition: all 0.2s ease;\n}\n.whnz3-web_hosting-btn-ghost:hover { border-color: #0CC0DF; color: #0CC0DF !important; }\n.whnz3-web_hosting-img { width: 130%; max-width: 130%; margin-left: -15%; height: auto; display: block; }\n@media (max-width: 900px) {\n    .whnz3-web_hosting-hero { padding: 190px 20px 30px; }\n    .whnz3-web_hosting-img { width: 90%; max-width: 400px; height: auto; aspect-ratio: 1.567; object-fit: cover; margin: 0 auto; display: block; border-radius: 12px; }\n    .whnz3-web_hosting-inner { grid-template-columns: 1fr; display: flex; flex-direction: column; gap: 0; text-align: center; }\n    .whnz3-web_hosting-inner > div:first-child { display: contents; }\n    .whnz3-web_hosting-pill-badge { order: 1; margin: 0 auto 12px; padding: 6px 14px; font-size: 10px; }\n    .whnz3-web_hosting-h1 { order: 2; margin-bottom: 10px; }\n    .whnz3-web_hosting-imgwrap { order: 3; margin-bottom: 10px; }\n    .whnz3-web_hosting-desc { order: 4; margin: 0 auto 16px; }\n    .whnz3-web_hosting-pills { order: 5; justify-content: center; margin-bottom: 8px; }\n    .whnz3-web_hosting-pill { padding: 6px 12px; font-size: 11px; margin: 0 6px 8px; }\n    .whnz3-web_hosting-ctas { order: 6; justify-content: center; }\n}\n</style>\n<section class=\"whnz3-web_hosting-hero\">\n    <div class=\"whnz3-web_hosting-inner\">\n        <div>\n            <span class=\"whnz3-web_hosting-pill-badge\"><i></i>BUILT FOR NZ SMALL BUSINESSES</span>\n            <h1 class=\"whnz3-web_hosting-h1\">Small Business <span>Web Hosting NZ</span></h1>\n            <p class=\"whnz3-web_hosting-desc\">You get a fast, secure website and email on your own domain, without learning how servers work.</p>\n            <div class=\"whnz3-web_hosting-pills\"><span class=\"whnz3-web_hosting-pill\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>Free SSL</span><span class=\"whnz3-web_hosting-pill\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>99.99% Uptime</span><span class=\"whnz3-web_hosting-pill\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>Free Backups</span></div>\n            <div class=\"whnz3-web_hosting-ctas\">\n                <a href=\"#plans\" class=\"whnz3-web_hosting-btn-solid\">View Plans &rarr;</a>\n                <a href=\"/contact\" class=\"whnz3-web_hosting-btn-ghost\">Talk to Experts</a>\n            </div>\n        </div>\n        <div class=\"whnz3-web_hosting-imgwrap\"><img loading=\"eager\" src=\"/images/hero/small-business-hosting.webp\" width=\"1087\" height=\"755\" alt=\"A small business website on a laptop overlooking a New Zealand coastal landscape\" class=\"whnz3-web_hosting-img\" fetchpriority=\"high\" decoding=\"async\"></div>\n    </div>\n</section>"