ia-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/2.png\" alt=\"Web Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Web Hosting</h4>\n                        <p>Fast &amp; affordable hosting</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/wordpress-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/4.png\" alt=\"WordPress Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>WordPress Hosting</h4>\n                        <p>Optimized for WordPress</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/website-builder-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2026/02/5.jpg\" alt=\"Website Builder Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Website Builder Hosting</h4>\n                        <p>Build a site easily</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/cloud-servers\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/1.png\" alt=\"Cloud Servers\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Cloud Servers</h4>\n                        <p>Scale when you grow</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/vps-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/3.png\" alt=\"VPS Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>VPS Hosting</h4>\n                        <p>Dedicated resources</p>\n                    </span>\n                </a>\n                    </div>\n    </div>\n\n    \n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</header>\n\t\t\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"5081\" class=\"elementor elementor-5081\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-b9cffcc e-con-full e-flex e-con e-parent\" data-id=\"b9cffcc\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-506482d elementor-widget elementor-widget-shortcode\" data-id=\"506482d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\"><style>\n    /* VARIABLES & RESET */\n    :root {\n        --mail-primary: #0CC0DF;\n        --mail-primary-dark: #0896af;\n        --mail-accent: #6366f1;\n        --mail-text: #0f172a;\n        --mail-text-muted: #475569;\n        --mail-glass: rgba(255, 255, 255, 0.9);\n        --mail-glass-border: rgba(255, 255, 255, 0.7);\n        --mail-shadow: 0 10px 40px -10px rgba(12, 192, 223, 0.15);\n        --mail-bg: #f8fafc;\n        --mail-red: #ef4444;\n        --mail-green: #10b981;\n    }\n\n    .wh_mail_lp_9540 {\n        font-family: 'Inter', system-ui, -apple-system, sans-serif;\n        color: var(--mail-text);\n        background: var(--mail-bg);\n        background-image: \n            radial-gradient(at 0% 0%, hsla(192,90%,94%,1) 0, transparent 50%), \n            radial-gradient(at 100% 0%, hsla(230,90%,94%,1) 0, transparent 50%);\n        background-attachment: fixed;\n        width: 100%;\n        overflow-x: hidden;\n        position: relative;\n        line-height: 1.6;\n    }\n\n    .wh_mail_lp_9540 * { box-sizing: border-box; }\n    \n    .wh_mail_lp_9540 section {\n        position: relative;\n        padding: 90px 20px; \n        max-width: 1140px;\n        margin: 0 auto;\n    }\n\n    /* TYPOGRAPHY */\n    .wh_mail_lp_9540 h1, .wh_mail_lp_9540 h2, .wh_mail_lp_9540 h3, .wh_mail_lp_9540 h4 {\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        line-height: 1.2;\n        margin-top: 0;\n        margin-bottom: 1rem;\n    }\n\n    .wh_mail_lp_9540 h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); text-align: center; }\n    .wh_mail_lp_9540 h3 { font-size: 1.4rem; }\n    \n    .wh_mail_lp_9540 .subtitle { \n        text-align: center; \n        font-size: 1.1rem; \n        color: var(--mail-text-muted); \n        max-width: 700px; \n        margin: -0.5rem auto 3rem auto; \n    }\n\n    .wh_mail_lp_9540 .gradient-text {\n        background: linear-gradient(135deg, var(--mail-primary) 0%, var(--mail-accent) 100%);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n        background-clip: text;\n    }\n\n    .wh_mail_lp_9540 p { margin-bottom: 1.2rem; font-size: 1.05rem; }\n\n    /* BUTTONS */\n    .wh_mail_lp_9540 .wh-btn {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        padding: 1rem 2rem;\n        border-radius: 10px;\n        font-weight: 800;\n        text-decoration: none;\n        transition: all 0.2s ease;\n        font-size: 1rem;\n        cursor: pointer;\n        border: none;\n    }\n\n    .wh_mail_lp_9540 .btn-primary {\n        background: var(--mail-primary);\n        color: white;\n        box-shadow: 0 6px 15px rgba(12, 192, 223, 0.25);\n    }\n\n    .wh_mail_lp_9540 .btn-primary:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 10px 20px rgba(12, 192, 223, 0.35);\n        background: var(--mail-primary-dark);\n        color: white;\n    }\n\n    /* HERO SECTION */\n    .wh_mail_lp_9540 .hero-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        align-items: center;\n        gap: 4rem;\n        /* INCREASED PADDING TO CLEAR HEADER MENU */\n        padding-top: 180px;\n        padding-bottom: 80px; \n    }\n\n    .wh_mail_lp_9540 .hero-content h1 { \n        font-size: clamp(2.8rem, 5vw, 4rem); \n        line-height: 1.1;\n        margin-bottom: 1.2rem;\n    }\n\n    /* STORAGE SELECTOR */\n    .wh_mail_lp_9540 .storage-toggle {\n        display: flex;\n        gap: 1rem;\n        margin: 2rem 0;\n    }\n\n    .wh_mail_lp_9540 .storage-card {\n        background: white;\n        border: 2px solid #e2e8f0;\n        padding: 15px;\n        border-radius: 12px;\n        cursor: pointer;\n        transition: all 0.2s ease;\n        flex: 1;\n        display: flex;\n        align-items: center;\n        gap: 12px;\n    }\n\n    .wh_mail_lp_9540 .storage-card.active {\n        border-color: var(--mail-primary);\n        box-shadow: var(--mail-shadow);\n        background: #f0fdfa;\n    }\n\n    .wh_mail_lp_9540 .radio-dot {\n        width: 20px; height: 20px; border: 2px solid #cbd5e1; border-radius: 50%; position: relative; flex-shrink: 0;\n    }\n    .wh_mail_lp_9540 .active .radio-dot { border-color: var(--mail-primary); }\n    .wh_mail_lp_9540 .active .radio-dot::after {\n        content: ''; position: absolute; top: 3px; left: 3px; width: 10px; height: 10px;\n        background: var(--mail-primary); border-radius: 50%;\n    }\n\n    /* HERO VISUAL & ENLARGED COMPARISON */\n    .wh_mail_lp_9540 .hero-visual { display: flex; flex-direction: column; align-items: flex-end; }\n    \n    .wh_mail_lp_9540 .comparison-box {\n        background: var(--mail-glass);\n        backdrop-filter: blur(20px);\n        -webkit-backdrop-filter: blur(20px);\n        border: 1px solid var(--mail-glass-border);\n        border-radius: 24px;\n        padding: 40px; \n        width: 100%;\n        max-width: 550px; \n        box-shadow: var(--mail-shadow);\n    }\n    \n    .wh_mail_lp_9540 .comp-title {\n        text-align: center; \n        font-weight: 800; \n        font-size: 1.4rem; \n        color: var(--mail-text); \n        margin-bottom: 30px; \n        letter-spacing: -0.01em; \n        text-transform: uppercase;\n    }\n\n    .wh_mail_lp_9540 .comp-grid {\n        display: flex; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 30px;\n    }\n    \n    .wh_mail_lp_9540 .comp-side { flex: 1; text-align: center; }\n    .wh_mail_lp_9540 .comp-side.bad { border-right: 1px solid rgba(0,0,0,0.05); padding-right: 20px; }\n    .wh_mail_lp_9540 .comp-side.good { padding-left: 20px; }\n    \n    .wh_mail_lp_9540 .comp-icon {\n        width: 48px; \n        height: 48px; \n        border-radius: 50%; \n        display: inline-flex; \n        align-items: center; \n        justify-content: center; \n        color: white; \n        margin-bottom: 15px;\n    }\n    .wh_mail_lp_9540 .comp-icon svg { width: 24px; height: 24px; }\n    .wh_mail_lp_9540 .comp-icon.bad { background: var(--mail-red); }\n    .wh_mail_lp_9540 .comp-icon.good { background: var(--mail-green); }\n    \n    .wh_mail_lp_9540 .comp-email { \n        font-family: monospace; \n        font-size: 1.05rem; \n        margin-bottom: 12px; \n        word-break: break-all; \n    }\n    .wh_mail_lp_9540 .comp-email.bad { color: #64748b; text-decoration: line-through; }\n    .wh_mail_lp_9540 .comp-email.good { color: var(--mail-primary-dark); font-weight: 700; }\n    \n    .wh_mail_lp_9540 .comp-desc { \n        font-size: 1rem; \n 