ia-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/2.png\" alt=\"Web Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Web Hosting</h4>\n                        <p>Fast &amp; affordable hosting</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/wordpress-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/4.png\" alt=\"WordPress Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>WordPress Hosting</h4>\n                        <p>Optimized for WordPress</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/website-builder-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2026/02/5.jpg\" alt=\"Website Builder Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Website Builder Hosting</h4>\n                        <p>Build a site easily</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/cloud-servers\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/1.png\" alt=\"Cloud Servers\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>Cloud Servers</h4>\n                        <p>Scale when you grow</p>\n                    </span>\n                </a>\n                            <a class=\"whnz-card\" href=\"/vps-hosting\">\n                    <span class=\"whnz-ic\" aria-hidden=\"true\">\n                                                    <img loading=\"lazy\" src=\"https://webhosting.co.nz/wp-content/uploads/2025/11/3.png\" alt=\"VPS Hosting\" width=\"24\" height=\"24\">\n                                            </span>\n                    <span>\n                        <h4>VPS Hosting</h4>\n                        <p>Dedicated resources</p>\n                    </span>\n                </a>\n                    </div>\n    </div>\n\n    \n    </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</header>\n\t\t\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"1336\" class=\"elementor elementor-1336\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-dee5ff0 e-con-full e-flex e-con e-parent\" data-id=\"dee5ff0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a9da29f elementor-widget elementor-widget-shortcode\" data-id=\"a9da29f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"shortcode.default\">\n\t\t\t\t\t\t\t<div class=\"elementor-shortcode\">    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');\n\n        .whnzd-wrap, .whnzd-wrap * { box-sizing: border-box; margin: 0; padding: 0; }\n\n        .whnzd-wrap {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            background: #ffffff;\n            overflow: clip; /* FIXED: Prevents double vertical scrollbar */\n            color: #000000;\n        }\n\n        /* \u2500\u2500 ANIMATIONS \u2500\u2500 */\n        @keyframes whnzdFadeUp {\n            0% { opacity: 0; transform: translateY(30px); }\n            100% { opacity: 1; transform: translateY(0); }\n        }\n\n        .whnzd-animate-up {\n            opacity: 0; \n            animation: whnzdFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        .whnzd-delay-1 { animation-delay: 0.1s; }\n        .whnzd-delay-2 { animation-delay: 0.2s; }\n        .whnzd-delay-3 { animation-delay: 0.3s; }\n        .whnzd-delay-4 { animation-delay: 0.4s; }\n        .whnzd-delay-5 { animation-delay: 0.5s; }\n\n        /* \u2500\u2500 HERO SECTION \u2500\u2500 */\n        .whnzd-hero {\n            min-height: auto;\n            background: #ffffff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: 100px 40px 60px; \n        }\n\n        /* Homepage subtle dot pattern */\n        .whnzd-hero::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background-image: radial-gradient(circle, rgba(12,192,223,0.15) 1px, transparent 1px);\n            background-size: 32px 32px;\n            pointer-events: none;\n        }\n\n        .whnzd-hero-inner {\n            max-width: 1280px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1.1fr 0.9fr; \n            gap: 40px;\n            align-items: center;\n            position: relative;\n            z-index: 2;\n            width: 100%;\n        }\n\n        /* \u2500\u2500 LEFT COLUMN (TEXT) \u2500\u2500 */\n        .whnzd-hero-tag {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            border: 1.5px solid rgba(12,192,223,0.4);\n            background: rgba(12,192,223,0.05);\n            backdrop-filter: blur(8px);\n            padding: 7px 16px 7px 10px;\n            border-radius: 100px;\n            font-size: 11px;\n            font-weight: 700;\n            letter-spacing: 0.08em;\n            color: #000000;\n            margin-bottom: 25px;\n            text-transform: uppercase;\n        }\n\n        .whnzd-hero-tag i {\n            width: 20px; height: 20px;\n            background: #0CC0DF;\n            border-radius: 50%;\n            display: inline-flex; align-items: center; justify-content: center;\n            color: #ffffff; font-style: normal; font-size: 12px; font-weight: 900;\n        }\n\n        .whnzd-hero h1 {\n            font-family: 'Outfit', sans-serif;\n            font-size: clamp(40px, 5vw, 68px);\n            font-weight: 800;\n            color: #000000;\n            letter-spacing: -0.03em;\n            line-height: 1.05;\n            margin-bottom: 22px;\n        }\n\n        .whnzd-hero h1 em {\n            font-style: normal;\n            color: #0CC0DF;\n        }\n\n        /* MOBILE ONLY IMAGE HIDDEN BY DEFAULT */\n        .whnzd-mobile-img {\n            display: none;\n            width: 100%;\n            height: auto;\n            border-radius: 20px;\n        }\n\n        .whnzd-hero-sub {\n            font-size: 17px;\n            color: rgba(0,0,0,0.7);\n            line-height: 1.75;\n            margin-bottom: 30px;\n            font-weight: 400;\n            max-width: 520px;\n        }\n\n        /* \u2500\u2500 FEATURE PILLS \u2500\u2500 */\n        .whnzd-features {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 12px;\n            margin-bottom: 25px;\n            max-width: 550px;\n        }\n\n        .whnzd-feature-pill {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            font-size: 13px;\n            font-weight: 600;\n            color: #5a6478;\n            background: #ffffff;\n            border: 1px solid #eaedf3;\n            padding: 8px 16px;\n            border-radius: 100px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.02);\n            transition: all 0.3s ease;\n        }\n\n        .whnzd-feature-pill:hover {\n            border-color: #0CC0DF;\n            color: #0CC0DF;\n        }\n\n        /* \u2500\u2500 BUTTONS \u2500\u2500 */\n        .whnzd-cta-row {\n            display: flex;\n            gap: 16px;\n            flex-wrap: wrap;\n            align-items: center;\n        }\n\n        .whnzd-btn-solid {\n            background: #0CC0DF;\n            color: #ffffff !important;\n            text-decoration: none !important;\n            padding: 16px 36px;\n            border-radius: 10px;\n            font-family: 'Outfit', sans-serif;\n            font-weight: 700;\n            font-size: 13px;\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            transition: all 0.25s ease;\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            box-shadow: 0 4px 24px rgba(12,192,223,0.3);\n        }\n        .whnzd-btn-solid:hover {\n            background: #000000;\n            box-shadow: 0 8px 36px rgba(0,0,0,0.45);\n            transform: translateY(-2px);\n        }\n\n        .whnzd-btn-ghost {\n            background: transparent;\n            color: #000000 !important;\n            text-decoration: none !important;\n            padding: 15px 36px;\n            border-radius: 10px;\n            font-family: 'Outfit', sans-serif;\n            font-weight: 700;\n            font-size: 13px;\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            border: 2px solid #000000;\n            transition: all 0.25s ease;\n            display: inline-block;\n        }\n        .whnzd-btn-ghost:hover {\n            border-color: #0CC0DF;\n            color: #0CC0DF !important;\n        }\n\n        /* \u2500\u2500 RIGHT COLUMN (IMAGE) \u2500\u2500 */\n        .whnzd-hero-right {\n            display: flex;\n            justify-content: flex-end;\n            align-items: center;\n            width: 100%;\n        }\n\n        .whnzd-hero-img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n            border-radius: 20px;\n        }\n\n        /* \u2500\u2500 INFO BOX SECTION \u2500\u2500 */\n        .whnzd-info-section {\n            padding: 0 40px 80px; \n            display: flex;\n            justify-content: center;\n            position: relative;\n            z-index: 2;\n        }\n\n        .whnzd-info-box {\n            background: #f4fcff; \n            border: 1px solid rgba(12, 192, 223, 0.2);\n            border-radius: 16px;\n            padding: 35px 40px;\n            max-width: 850px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.02);\n        }\n\n        .whnzd-info-box h4 {\n            font-family: 'Outfit', sans-serif;\n            font-size: 22px;\n            font-weight: 800;\n            color: #0a0f1e;\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            margin-bottom: 16px;\n            letter-spacing: -0.01em;\n        }\n\n        .whnzd-info-box h4 svg {\n            width: 22px;\n            height: 22px;\n            stroke: #0CC0DF;\n            flex-shrink: 0;\n        }\n\n        .whnzd-info-box p {\n            font-family: 'Plus Jakarta Sans', sans-serif;\n            font-size: 15px;\n            color: #5a6478;\n            line-height: 1.7;\n            margin-bottom: 0;\n        }\n\n        /* \u2500\u2500 RESPONSIVE / MOBILE LAYOUT \u2500\u2500 */\n        @media (max-width: 900px) {\n            .whnzd-hero {\n                padding-top: 80px; \n                padding-bottom: 40px; \n            }\n            .whnzd-hero-inner { \n                display: flex; \n                flex-direction: column; \n                text-align: center; \n                gap: 30px;\n            }\n            \n            /* Hides the right column image on mobile entirely */\n            .whnzd-hero-right { display: none; }\n\n            /* Shows the inline image between title and text */\n            .whnzd-mobile-img {\n                display: block;\n                margin: 0 auto 25px auto;\n                max-width: 95%;\n            }\n\n            .whnzd-hero-tag { margin: 0 auto 20px; }\n            .whnzd-hero h1 { margin-bottom: 25px; }\n            .whnzd-hero-sub { margin: 0 auto 30px; }\n            .whnzd-features { justify-content: center; margin: 0 auto 30px; }\n            .whnzd-cta-row { justify-content: center; }\n            \n            .whnzd-info-section { padding: 0 30px 60px; }\n        }\n\n        @media (max-width: 600px) {\n            .whnzd-hero { padding-left: 20px; padding-right: 20px; }\n            .whnzd-features { gap: 8px; }\n            .whnzd-feature-pill { font-size: 11px; padding: 6px 12px; }\n            .whnzd-cta-row { flex-direction: column; width: 100%; }\n            .whnzd-btn-solid, .whnzd-btn-ghost { width: 100%; text-align: center; justify-content: center; }\n\n            .whnzd-info-section { padding: 0 20px 60px; }\n            .whnzd-info-box { padding: 25px 25px; }\n            .whnzd-info-box h4 { font-size: 18px; align-items: flex-start; }\n            .whnzd-info-box h4 svg { margin-top: 2px; width: 20px; height: 20px; }\n            .whnzd-info-box p { font-size: 14.5px; }\n        }\n    </style>\n\n    <div class=\"whnzd-wrap\">\n        <section class=\"whnzd-hero\">\n            <div class=\"whnzd-hero-inner\">\n                \n                <div class=\"whnzd-hero-left\">\n                    <div class=\"whnzd-hero-tag whnzd-animate-up whnzd-delay-1\">\n                        <i>&#10003;</i>&nbsp;NEW ZEALAND'S TRUSTED DOMAIN REGISTRAR\n                    </div>\n                    \n                    <h1 class=\"whnzd-animate-up whnzd-delay-2\">Buy a New Zealand<br><em>Domain Name</em></h1>\n                    \n                    <img decoding=\"async\" src=\"https://webhosting.co.nz/wp-content/uploads/2026/02/domain-1.png\" alt=\"Domain S