; color: #6b7280; }\n\n        .nxt-search-box {\n            display: flex;\n            background-color: #f4f6f9;\n            border: 1px solid #e5e7eb;\n            border-radius: 50px;\n            padding: 8px 8px 8px 25px;\n            align-items: center;\n            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);\n        }\n\n        .nxt-search-input {\n            flex: 1;\n            background: transparent;\n            border: none;\n            color: #333;\n            font-size: 16px;\n            outline: none;\n            min-width: 150px;\n        }\n\n        .nxt-search-input::placeholder { color: #9ca3af; }\n\n        .nxt-btn {\n            padding: 12px 25px;\n            font-size: 15px;\n            font-weight: 600;\n            border-radius: 50px;\n            cursor: pointer;\n            border: none;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n            transition: all 0.2s;\n            white-space: nowrap;\n        }\n\n        .nxt-btn-search { background-color: #000; color: #fff; margin-right: 10px; }\n        .nxt-btn-search:hover { background-color: #333; }\n        .nxt-btn-transfer { background-color: #00c6d7; color: #fff; }\n        .nxt-btn-transfer:hover { background-color: #00b0bf; }\n        .nxt-btn:disabled { opacity: .6; cursor: not-allowed; }\n\n        .nxt-results-area { margin-top: 25px; }\n\n        .nxt-result-row {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 12px 25px;\n            border-radius: 50px;\n            margin-bottom: 15px;\n            font-size: 15px;\n            color: #4b5563;\n            transition: all 0.3s ease;\n            word-break: break-word;\n        }\n\n        .nxt-main-result {\n            box-shadow: 0 4px 10px rgba(0,0,0,0.08);\n            border-width: 2px !important;\n            margin-bottom: 30px;\n            transform: scale(1.02);\n        }\n\n        .nxt-row-taken { background-color: #fdf2f2; border: 1px solid #fde8e8; }\n        .nxt-row-avail { background-color: #f0fdf4; border: 1px solid #dcfce7; }\n        .nxt-row-wait { background-color: #f3f4f6; border: 1px solid #e5e7eb; }\n\n        .nxt-status-btn {\n            border-radius: 50px;\n            padding: 6px 20px;\n            font-weight: bold;\n            border: none;\n            font-size: 13px;\n            text-decoration: none;\n            text-align: center;\n            min-width: 110px;\n            display: inline-block;\n            cursor: default;\n        }\n\n        .nxt-btn-err { background-color: #d85c6a; color: white; }\n        .nxt-btn-buy { background-color: #10b981; color: white; cursor: pointer; }\n        .nxt-btn-buy:hover { background-color: #059669; color: white; }\n        .nxt-btn-wait {\n            background-color: #6b7280;\n            color: white;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n        }\n\n        .nxt-spinner {\n            width: 14px;\n            height: 14px;\n            border: 2px solid rgba(255,255,255,0.3);\n            border-radius: 50%;\n            border-top-color: #fff;\n            animation: nxtspin 1s linear infinite;\n        }\n\n        @keyframes nxtspin { 100% { transform: rotate(360deg); } }\n\n        @media (max-width: 768px) {\n            .nxt-header h2 { font-size: 24px; }\n\n            .nxt-search-box {\n                flex-direction: column;\n                background-color: transparent;\n                border: none;\n                box-shadow: none;\n                padding: 0;\n            }\n\n            .nxt-search-input {\n                width: 100%;\n                background-color: #f4f6f9;\n                border: 1px solid #e5e7eb;\n                padding: 15px 20px;\n                border-radius: 50px;\n       