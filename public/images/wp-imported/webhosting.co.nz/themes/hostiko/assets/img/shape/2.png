				<div class="elementor-element elementor-element-683f408 elementor-widget elementor-widget-shortcode" data-id="683f408" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default">
							<div class="elementor-shortcode">
    <style>
        /* ===== TRUE CENTER FIX (targets your 404 page ID 4877) ===== */
        body.page-id-4877 #page,
        body.postid-4877 #page{
            min-height: 100vh !important;
            display: flex !important;
            flex-direction: column !important;
        }

        /* Make content area fill remaining height under header */
        body.page-id-4877 #content,
        body.postid-4877 #content,
        body.page-id-4877 .site-content,
        body.postid-4877 .site-content{
            flex: 1 1 auto !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Kill theme page title spacing if it exists */
        body.page-id-4877 .page-title-area,
        body.postid-4877 .page-title-area{
            display: none !important;
        }

        /* Remove extra container padding that pushes center */
        body.page-id-4877 #content .container,
        body.postid-4877 #content .container,
        body.page-id-4877 .site-content .container,
        body.postid-4877 .site-content .container{
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* ===== Your 404 design ===== */
        .whnz-404-wrap{
            width: 100%;
            display:flex;
            align-items:center;
            justify-content:center;
            text-align:center;
            padding: 40px 20px;
            background:#ffffff;
            box-sizing:border-box;
        }

        .whnz-404-card{
            max-width: 900px;
            width: 100%;
            margin: 0 auto;
        }

        .whnz-404-image{
            max-width: 520px;
            width: 100%;
            margin: 0 auto 26px auto;
            display:block;
        }

        .whnz-404-title{
            font-size: 42px;
            font-weight: 800;
            color:#0CC0DF;
            margin: 0;
        }

        .whnz-404-text{
            margin-top: 10px;
            color:#555;
            font-size:16px;
            line-height: 1.6;
        }

        .whnz-404-btns{
            margin-top: 26px;
            display:flex;
            gap: 14px;
            justify-content:center;
            flex-wrap:wrap;
        }

        .whnz-btn{
            padding: 14px 26px;
            border-radius: 50px;
            text-decoration:none;
            font-weight: 700;
            transition: .2s ease;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-width: 170px;
        }

        .whnz-btn-primary{
            background: linear-gradient(90deg,#0CC0DF,#00e5ff);
            color:#fff;
            border: none;
        }
        .whnz-btn-primary:hover{
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(12,192,223,0.30);
        }

        .whnz-btn-secondary{
            border:1px solid #0CC0DF;
            color:#0CC0DF;
            background: #fff;
        }
        .whnz-btn-secondary:hover{
            background:#0CC0DF;
            color:#fff;
        }

        @media (max-width: 600px){
            .whnz-404-title{ font-size: 34px; }
            .whnz-btn{ width: 100%; max-width: 320px; }
        }
    </style>

    <div class="whnz-404-wrap">
        <div class="whnz-404-card">

            <img class="whnz-404-image"
                 src="https://webhosting.co.nz/wp-content/uploads/2026/02/404.png"
                 alt="404 Not Found">

            <h1 class="whnz-404-title">Page Not Found</h1>

            <div class="whnz-404-text">
                The page you’re looking for doesn’t exist or has been moved.<br>
                Let’s get your website back online in seconds.
            </div>

            <div class="whnz-404-btns">
               <a class="whnz-btn whnz-btn-primary" href="https://webhosting.co.nz/">
    Go to Homepage
</a>

<a class="whnz-btn whnz-btn-secondary" href="https://webhosting.co.nz/#hosting-plans">
    View Hosting Plans
</a>

<a class="whnz-btn whnz-btn-secondary" href="https://webhosting.co.nz/contact/">
    Contact Support
</a>
            </div>

        </div>
    </div>

    </div>
