"\n    (function(){\n        const uid = \"whnz_nav_wrapper\";\n        const root = document.querySelector('.' + uid + '[data-whnz-nav]');\n        if(!root) return;\n\n        const burger = root.querySelector('.whnz-burger');\n        const mobile = root.querySelector('.whnz-mobile');\n        const toggle = root.querySelector('[data-whnz-toggle=\"hosting\"]');\n        const sub = root.querySelector('[data-whnz-sub=\"hosting\"]');\n\n        function openMenu(){\n            mobile.classList.add('open');\n            burger.classList.add('is-open');\n            burger.setAttribute('aria-expanded', 'true');\n        }\n        function closeMenu(){\n            mobile.classList.remove('open');\n            burger.classList.remove('is-open');\n            burger.setAttribute('aria-expanded', 'false');\n        }\n\n        if(burger && mobile){\n            burger.addEventListener('click', (e) => {\n                e.preventDefault(); e.stopPropagation();\n                mobile.classList.contains('open') ? closeMenu() : openMenu();\n            });\n        }\n\n        if(toggle && sub){\n            toggle.addEventListener('click', (e) => {\n                e.preventDefault();\n                sub.classList.toggle('open');\n            });\n        }\n\n        document.addEventListener('click', (e) => {\n            if(window.innerWidth > 980) return;\n            if(!mobile.classList.contains('open')) return;\n            if(root.contains(e.target)) return;\n            closeMenu();\n        });\n\n        // Desktop Mega Menu\n        const trigger = root.querySelector('[data-whnz-trigger=\"hosting\"]');\n        const mega = document.querySelector('.' + uid + '-mega[data-whnz-mega=\"hosting\"]');\n        let megaOpen = false;\n        let closeTimer = null;\n\n        function positionMega(){\n            if(!trigger || !mega) return;\n            const r = trigger.getBoundingClientRect();\n            const megaWidth = mega.offsetWidth || 640;\n            const margin = 16;\n            let left = r.left + (r.width / 2) - (megaWidth / 2);\n            left = Math.max(margin, Math.min(left, window.innerWidth - megaWidth - margin));\n            mega.style.left = left + 'px';\n            mega.style.top = (r.bottom + 12) + 'px';\n        }\n\n        function openMega(){\n            if(!mega) return;\n            clearTimeout(closeTimer);\n            positionMega();\n            mega.classList.add('open');\n            trigger.classList.add('is-active');\n            trigger.setAttribute('aria-expanded', 'true');\n            megaOpen = true;\n        }\n        function closeMega(){\n            if(!mega) return;\n            mega.classList.remove('open');\n            trigger.classList.remove('is-active');\n            trigger.setAttribute('aria-expanded', 'false');\n            megaOpen = false;\n        }\n        function scheduleClose(){\n            clearTimeout(closeTimer);\n            closeTimer = setTimeout(closeMega, 150);\n        }\n\n        if(trigger && mega){\n            trigger.addEventListener('mouseenter', () => { if(window.innerWidth > 980) openMega(); });\n            trigger.addEventListener('mouseleave', () => { if(window.innerWidth > 980) scheduleClose(); });\n            mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));\n            mega.addEventListener('mouseleave', scheduleClose);\n\n            trigger.addEventListener('click', (e) => {\n                e.preventDefault();\n                megaOpen ? closeMega() : openMega();\n            });\n\n            window.addEventListener('resize', () => { if(megaOpen) positionMega(); });\n            window.addEventListener('scroll', () => { if(megaOpen) positionMega(); }, { passive: true });\n\n            document.addEventListener('click', (e) => {\n                if(root.contains(e.target) || mega.contains(e.target)) return;\n                closeMega();\n            });\n        }\n\n        // Trigger card background appearance when scrolled down past 20px\n        window.addEventListener('scroll', () => {\n            root.classList.toggle('scrolled', window.pageYOffset > 20);\n        }, { passive: true });\n    })();\n    \n\nvar slider_handel_img = \"/images/wp-imported/hostiko.com/uploads/2024/06/vps-circle-icon.png\";\n\n\t\t\tvar cpu_arr = new Array('1 Cores', '2 Cores', '4 Cores', '6 Cores', '8 Cores', '10 Cores');\n\t\t\tvar ram_arr = new Array('1 GB', '2 GB', '4 GB', '8 GB', '16 GB', '32 GB');\n\t\t\tvar hdd_arr = new Array('25 GB', '50 GB', '75 GB', '100 GB', '200 GB', '400 GB');\n\t\t\tvar bandwidth_arr = new Array('100 Mbps', '100 Mbps', '250 Mbps', '500 Mbps', '1000 Mbps', '1000 Mbps');\n\t\t\tvar ip_arr = new Array('3 IPs', '5 IPs', '7 IPs', '9 IPs', 'Unlimited')\n\t\t\tvar price_arr = new Array('23', '36', '57', '114', '178', '449');\n\t\t\tvar decimal_arr = new Array('99', '99', '99', '99', '99', '99');\n\t\t\tvar link_arr = new Array('$10', '$25', '$50', '$75', '$100', '$125');\n\t\t\tvar b_url = new Array('https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/1-cores-vps-1', 'https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/2-cores-vps-1', 'https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/4-cores-vps-1', 'https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/6-cores-vps-1', 'https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/8-cores-vps-1', 'https://my.webhosting.co.nz/index.php?rp=/store/vps-hosting/10-cores-vps-1');\n\t\t\tvar def_pos = 2;\n\t\t\t\tjQuery(document).ready(function() {\n\t\t\t\t\t\n\t\t\t\t\tjQuery(\"#slider\").slider({\n\t\t\t\t\trange: 'min',\n\t\t\t\t\tanimate: true,\n\t\t\t\t\tmin: 1,\n\t\t\t\t\tmax: 6,\n\t\t\t\t\tpaddingMin: 50,\n\t\t\t\t\tpaddingMax: 80,\n\t\t\t\t\tchange: function(event, ui) {\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #cpu_val h4.value').html(cpu_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #ram_val h4.value').html(ram_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #hdd_val h4.value').html(hdd_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #bandwidth_val h4.value').html(bandwidth_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #ip_val h4.value').html(ip_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #price_val').html(price_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #decimal_val').html(\".\"+decimal_arr[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section a.buy_now').attr('href', b_url[ui.value - 1]);\n\t\t\t\t\t\tjQuery('.hostiko_vps_section div.price_rangetxt div#icon-' + (ui.value - 1)).addClass(\"current\");\n\t\t\t\t\t\tjQuery('.hostiko_vps_section #sub-heading-' + (ui.value - 1)).addClass(\"current1\");\n\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\tjQuery(\"#amount\").val(\"$\" + jQuery(\"#slider\").slider(\"value\"));\n\t\t\t\tjQuery('#slider').slider('value', def_pos);\n\t\t\t\tjQuery('.icon').click(function() {\n\t\t\t\t\tch_value = parseInt(this.id.slice(5)) + 1;\n\t\t\t\t\tjQuery(\".hostiko_vps_section div.price_rangetxt div\").removeClass(\"current\");\n\t\t\t\t\tjQuery(\".hostiko_vps_section .heading div\").removeClass(\"current1\");\n\t\t\t\t\tjQuery('#slider').slider('value', ch_value);\n\t\t\t\t});\n\t\t\t\t\n\t\t\t\tif(slider_handel_img != \"\"){\n\t\t\t\t\tjQuery(document).find(\".ui-slider-handle\").css(\"background-image\", \"url(\" + slider_handel_img + \")\");\n\t\t\t\t}\n\t\t\t\t\n\t\t\t});\n\n\t\t"