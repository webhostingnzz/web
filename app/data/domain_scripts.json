"\n    (function(){\n        const uid = \"whnz_nav_wrapper\";\n        const root = document.querySelector('.' + uid + '[data-whnz-nav]');\n        if(!root) return;\n\n        const burger = root.querySelector('.whnz-burger');\n        const mobile = root.querySelector('.whnz-mobile');\n        const toggle = root.querySelector('[data-whnz-toggle=\"hosting\"]');\n        const sub = root.querySelector('[data-whnz-sub=\"hosting\"]');\n\n        function openMenu(){\n            mobile.classList.add('open');\n            burger.classList.add('is-open');\n            burger.setAttribute('aria-expanded', 'true');\n        }\n        function closeMenu(){\n            mobile.classList.remove('open');\n            burger.classList.remove('is-open');\n            burger.setAttribute('aria-expanded', 'false');\n        }\n\n        if(burger && mobile){\n            burger.addEventListener('click', (e) => {\n                e.preventDefault(); e.stopPropagation();\n                mobile.classList.contains('open') ? closeMenu() : openMenu();\n            });\n        }\n\n        if(toggle && sub){\n            toggle.addEventListener('click', (e) => {\n                e.preventDefault();\n                sub.classList.toggle('open');\n            });\n        }\n\n        document.addEventListener('click', (e) => {\n            if(window.innerWidth > 980) return;\n            if(!mobile.classList.contains('open')) return;\n            if(root.contains(e.target)) return;\n            closeMenu();\n        });\n\n        // Desktop Mega Menu\n        const trigger = root.querySelector('[data-whnz-trigger=\"hosting\"]');\n        const mega = document.querySelector('.' + uid + '-mega[data-whnz-mega=\"hosting\"]');\n        let megaOpen = false;\n        let closeTimer = null;\n\n        function positionMega(){\n            if(!trigger || !mega) return;\n            const r = trigger.getBoundingClientRect();\n            const megaWidth = mega.offsetWidth || 640;\n            const margin = 16;\n            let left = r.left + (r.width / 2) - (megaWidth / 2);\n            left = Math.max(margin, Math.min(left, window.innerWidth - megaWidth - margin));\n            mega.style.left = left + 'px';\n            mega.style.top = (r.bottom + 12) + 'px';\n        }\n\n        function openMega(){\n            if(!mega) return;\n            clearTimeout(closeTimer);\n            positionMega();\n            mega.classList.add('open');\n            trigger.classList.add('is-active');\n            trigger.setAttribute('aria-expanded', 'true');\n            megaOpen = true;\n        }\n        function closeMega(){\n            if(!mega) return;\n            mega.classList.remove('open');\n            trigger.classList.remove('is-active');\n            trigger.setAttribute('aria-expanded', 'false');\n            megaOpen = false;\n        }\n        function scheduleClose(){\n            clearTimeout(closeTimer);\n            closeTimer = setTimeout(closeMega, 150);\n        }\n\n        if(trigger && mega){\n            trigger.addEventListener('mouseenter', () => { if(window.innerWidth > 980) openMega(); });\n            trigger.addEventListener('mouseleave', () => { if(window.innerWidth > 980) scheduleClose(); });\n            mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));\n            mega.addEventListener('mouseleave', scheduleClose);\n\n            trigger.addEventListener('click', (e) => {\n                e.preventDefault();\n                megaOpen ? closeMega() : openMega();\n            });\n\n            window.addEventListener('resize', () => { if(megaOpen) positionMega(); });\n            window.addEventListener('scroll', () => { if(megaOpen) positionMega(); }, { passive: true });\n\n            document.addEventListener('click', (e) => {\n                if(root.contains(e.target) || mega.contains(e.target)) return;\n                closeMega();\n            });\n        }\n\n        // Trigger card background appearance when scrolled down past 20px\n        window.addEventListener('scroll', () => {\n            root.classList.toggle('scrolled', window.pageYOffset > 20);\n        }, { passive: true });\n    })();\n    \n\n\n        document.addEventListener(\"DOMContentLoaded\", function() {\n            if ('IntersectionObserver' in window) {\n                const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };\n                const observer = new IntersectionObserver(function(entries, observerInstance) {\n                    entries.forEach(function(entry) {\n                        if (entry.isIntersecting) {\n                            entry.target.classList.add('whnzd2-visible');\n                            observerInstance.unobserve(entry.target); \n                        }\n                    });\n                }, observerOptions);\n\n                const elementsToAnimate = document.querySelectorAll('.whnzd2-animate');\n                elementsToAnimate.forEach(function(el) { observer.observe(el); });\n            } else {\n                const elementsToAnimate = document.querySelectorAll('.whnzd2-animate');\n                elementsToAnimate.forEach(function(el) { el.classList.add('whnzd2-visible'); });\n            }\n        });\n    \n\n\n    jQuery(document).ready(function($) {\n        const ajaxUrl = \"/api/domain-search/\";\n        const nonce = \"670190214b\";\n\n        const suggestionExtensions = ['.co.nz', '.nz', '.net.nz', '.com', '.net'];\n\n        function cleanDomain(input) {\n            input = String(input || '').trim().toLowerCase();\n            input = input.replace(/^(https?:\\/\\/)?(www\\.)?/, '');\n            input = input.split('/')[0].split('?')[0].split('#')[0];\n            input = input.replace(/[^a-z0-9.-]/g, '');\n            input = input.replace(/\\.+/g, '.').replace(/^\\./, '').replace(/\\.$/, '');\n            return input;\n        }\n\n        function splitDomain(domain) {\n            const knownTwoPartTlds = ['.co.nz', '.org.nz', '.net.nz', '.kiwi.nz', '.ac.nz', '.school.nz', '.gen.nz', '.geek.nz', '.maori.nz', '.iwi.nz'];\n\n            for (const tld of knownTwoPartTlds) {\n                if (domain.endsWith(tld)) {\n                    return {\n                        sld: domain.slice(0, -tld.length),\n                        tld: tld\n                    };\n                }\n            }\n\n            const dot = domain.indexOf('.');\n            if (dot === -1) {\n                return { sld: domain, tld: '.com' };\n            }\n\n            return {\n                sld: domain.slice(0, dot),\n                tld: domain.slice(dot)\n            };\n        }\n\n        function rowId(domain) {\n            return 'row_' + domain.replace(/[^a-z0-9]/g, '_');\n        }\n\n        function escapeHtml(text) {\n            return $('<div>').text(text).html();\n        }\n\n        function fireAjaxCheck(domainToCheck, actionType, isMain) {\n            const id = rowId(domainToCheck);\n            const mainClass = isMain ? ' nxt-main-result' : '';\n\n            const loadingHtml =\n                '<div id=\"' + id + '\" class=\"nxt-result-row nxt-row-wait' + mainClass + '\">' +\n                '<span>Checking <b>' + escapeHtml(domainToCheck) + '</b>...</span>' +\n                '<span class=\"nxt-status-btn nxt-btn-wait\"><span class=\"nxt-spinner\"></span> WAIT</span>' +\n                '</div>';\n\n            if (isMain) {\n                $('#nxt_results').prepend(loadingHtml);\n            } else {\n                $('#nxt_results').append(loadingHtml);\n            }\n\n            $.ajax({\n                url: ajaxUrl,\n                type: 'POST',\n                dataType: 'json',\n                timeout: 25000,\n                data: {\n                    action: 'nxt_check_domain_whmcs',\n                    security: nonce,\n                    domain: domainToCheck\n                },\n                success: function(response) {\n                    let html = '';\n                    const safeDomain = escapeHtml(domainToCheck);\n                    const regLink = 'https://my.webhosting.co.nz/cart.php?a=add&domain=register&query=' + encodeURIComponent(domainToCheck);\n                    const transLink = 'https://my.webhosting.co.nz/cart.php?a=add&domain=transfer&query=' + encodeURIComponent(domainToCheck);\n\n                    if (response && response.success && response.data && response.data.status === 'available') {\n                        if (actionType === 'transfer') {\n                            // An \"available\" domain (not registered anywhere) cannot be\n                            // transferred - there's nothing to transfer. Tell the user\n                            // clearly instead of showing a misleading Transfer button.\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                                '<span>\u2716 <b>' + safeDomain + '</b> is not registered, so it can\\'t be transferred. You can register it instead.</span>' +\n                                '<a href=\"' + regLink + '\" class=\"nxt-status-btn nxt-btn-buy\">REGISTER</a>' +\n                                '</div>';\n                        } else {\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-avail' + mainClass + '\">' +\n                                '<span><b>' + safeDomain + '</b> is available!</span>' +\n                                '<a href=\"' + regLink + '\" class=\"nxt-status-btn nxt-btn-buy\">BUY NOW</a>' +\n                                '</div>';\n                        }\n                    } else if (response && response.success && response.data && response.data.status === 'unavailable') {\n                        if (actionType === 'transfer') {\n                            // FIX: a registered domain is exactly what CAN be transferred.\n                            // Previously this branch always showed \"TAKEN\" regardless of\n                            // actionType, which made the Transfer button unusable.\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-avail' + mainClass + '\">' +\n                                '<span>Ready to transfer <b>' + safeDomain + '</b>?</span>' +\n                                '<a href=\"' + transLink + '\" class=\"nxt-status-btn nxt-btn-buy\">TRANSFER</a>' +\n                                '</div>';\n                        } else {\n                            html =\n                                '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                                '<span>\u2716 Sorry! <b>' + safeDomain + '</b> is already taken.</span>' +\n                                '<span class=\"nxt-status-btn nxt-btn-err\">TAKEN</span>' +\n                                '</div>';\n                        }\n                    } else {\n                        const msg = response && response.data && response.data.message ? response.data.message : 'Lookup failed';\n                        html =\n                            '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                            '<span>\u2716 <b>' + safeDomain + '</b>: ' + escapeHtml(msg) + '</span>' +\n                            '<span class=\"nxt-status-btn nxt-btn-err\">CHECK FAILED</span>' +\n                            '</div>';\n                    }\n\n                    $('#' + id).replaceWith(html);\n                },\n                error: function() {\n                    $('#' + id).replaceWith(\n                        '<div class=\"nxt-result-row nxt-row-taken' + mainClass + '\">' +\n                        '<span>\u2716 Server connection failed for <b>' + escapeHtml(domainToCheck) + '</b></span>' +\n                        '<span class=\"nxt-status-btn nxt-btn-err\">ERROR</span>' +\n                        '</div>'\n                    );\n                }\n            });\n        }\n\n        function initiateSearch(actionType) {\n            let inputVal = cleanDomain($('#nxt_domain_name').val());\n\n            if (!inputVal) {\n                alert('Please enter a domain name.');\n                return;\n            }\n\n            let parts = splitDomain(inputVal);\n            let baseName = parts.sld;\n            let mainExt = parts.tld;\n\n            if (!baseName || baseName.length < 2) {\n                alert('Please enter a valid domain name.');\n                return;\n            }\n\n            const mainDomain = baseName + mainExt;\n\n            $('#nxt_results').html('');\n            $('.nxt-btn').prop('disabled', true);\n\n            fireAjaxCheck(mainDomain, actionType, true);\n\n            if (actionType === 'search') {\n                const suggestions = suggestionExtensions\n                    .filter(tld => tld !== mainExt)\n                    .map(tld => baseName + tld);\n\n                suggestions.forEach(function(domain, index) {\n                    setTimeout(function() {\n                        fireAjaxCheck(domain, 'search', false);\n\n                        if (index === suggestions.length - 1) {\n                            setTimeout(function() {\n                                $('.nxt-btn').prop('disabled', false);\n                            }, 800);\n                        }\n                    }, 300 * (index + 1));\n                });\n            } else {\n                setTimeout(function() {\n                    $('.nxt-btn').prop('disabled', false);\n                }, 800);\n            }\n        }\n\n        $('#btn_search').on('click', function(e) {\n            e.preventDefault();\n            initiateSearch('search');\n        });\n\n        $('#btn_transfer').on('click', function(e) {\n            e.preventDefault();\n            initiateSearch('transfer');\n        });\n\n        $('#nxt_domain_name').on('keypress', function(e) {\n            if (e.which === 13) {\n                e.preventDefault();\n                initiateSearch('search');\n            }\n        });\n    });\n    "