"\n    (function(){\n        const uid = \"whnz_nav_wrapper\";\n        const root = document.querySelector('.' + uid + '[data-whnz-nav]');\n        if(!root) return;\n\n        const burger = root.querySelector('.whnz-burger');\n        const mobile = root.querySelector('.whnz-mobile');\n        const toggle = root.querySelector('[data-whnz-toggle=\"hosting\"]');\n        const sub = root.querySelector('[data-whnz-sub=\"hosting\"]');\n\n        function openMenu(){\n            mobile.classList.add('open');\n            burger.classList.add('is-open');\n            burger.setAttribute('aria-expanded', 'true');\n        }\n        function closeMenu(){\n            mobile.classList.remove('open');\n            burger.classList.remove('is-open');\n            burger.setAttribute('aria-expanded', 'false');\n        }\n\n        if(burger && mobile){\n            burger.addEventListener('click', (e) => {\n                e.preventDefault(); e.stopPropagation();\n                mobile.classList.contains('open') ? closeMenu() : openMenu();\n            });\n        }\n\n        if(toggle && sub){\n            toggle.addEventListener('click', (e) => {\n                e.preventDefault();\n                sub.classList.toggle('open');\n            });\n        }\n\n        document.addEventListener('click', (e) => {\n            if(window.innerWidth > 980) return;\n            if(!mobile.classList.contains('open')) return;\n            if(root.contains(e.target)) return;\n            closeMenu();\n        });\n\n        // Desktop Mega Menu\n        const trigger = root.querySelector('[data-whnz-trigger=\"hosting\"]');\n        const mega = document.querySelector('.' + uid + '-mega[data-whnz-mega=\"hosting\"]');\n        let megaOpen = false;\n        let closeTimer = null;\n\n        function positionMega(){\n            if(!trigger || !mega) return;\n            const r = trigger.getBoundingClientRect();\n            const megaWidth = mega.offsetWidth || 640;\n            const margin = 16;\n            let left = r.left + (r.width / 2) - (megaWidth / 2);\n            left = Math.max(margin, Math.min(left, window.innerWidth - megaWidth - margin));\n            mega.style.left = left + 'px';\n            mega.style.top = (r.bottom + 12) + 'px';\n        }\n\n        function openMega(){\n            if(!mega) return;\n            clearTimeout(closeTimer);\n            positionMega();\n            mega.classList.add('open');\n            trigger.classList.add('is-active');\n            trigger.setAttribute('aria-expanded', 'true');\n            megaOpen = true;\n        }\n        function closeMega(){\n            if(!mega) return;\n            mega.classList.remove('open');\n            trigger.classList.remove('is-active');\n            trigger.setAttribute('aria-expanded', 'false');\n            megaOpen = false;\n        }\n        function scheduleClose(){\n            clearTimeout(closeTimer);\n            closeTimer = setTimeout(closeMega, 150);\n        }\n\n        if(trigger && mega){\n            trigger.addEventListener('mouseenter', () => { if(window.innerWidth > 980) openMega(); });\n            trigger.addEventListener('mouseleave', () => { if(window.innerWidth > 980) scheduleClose(); });\n            mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));\n            mega.addEventListener('mouseleave', scheduleClose);\n\n            trigger.addEventListener('click', (e) => {\n                e.preventDefault();\n                megaOpen ? closeMega() : openMega();\n            });\n\n            window.addEventListener('resize', () => { if(megaOpen) positionMega(); });\n            window.addEventListener('scroll', () => { if(megaOpen) positionMega(); }, { passive: true });\n\n            document.addEventListener('click', (e) => {\n                if(root.contains(e.target) || mega.contains(e.target)) return;\n                closeMega();\n            });\n        }\n\n        // Trigger card background appearance when scrolled down past 20px\n        window.addEventListener('scroll', () => {\n            root.classList.toggle('scrolled', window.pageYOffset > 20);\n        }, { passive: true });\n    })();\n    \n\n\n        const whnzState = {\n            currentUrl: \"https://webhostingnz.com\",\n            businessName: \"Your Business Name\",\n            qrObj: null,\n            currentFormat: \"whnz-format-stand\"\n        };\n\n        // Initialize Google Maps Autocomplete\n        function initWhnzGoogleMaps() {\n            const input = document.getElementById('whnz-search');\n            if(!input) return;\n\n            const autocomplete = new google.maps.places.Autocomplete(input, {\n                fields: [\"place_id\", \"name\"],\n                types: [\"establishment\"]\n            });\n\n            autocomplete.addListener(\"place_changed\", () => {\n                const place = autocomplete.getPlace();\n                const errorMsg = document.getElementById('whnz-search-error');\n                \n                if (!place.place_id) {\n                    errorMsg.style.display = 'block';\n                    return;\n                }\n                \n                errorMsg.style.display = 'none';\n                \n                // FORCE remove address parts - split by comma and take first part\n                let rawName = place.name;\n                whnzState.businessName = rawName.split(',')[0].trim();\n                \n                whnzState.currentUrl = `https://search.google.com/local/writereview?placeid=${place.place_id}`;\n                \n                // Update Inputs & UI\n                document.getElementById('whnz-manual-url').value = whnzState.currentUrl;\n                document.getElementById('whnz-input-business-name').value = whnzState.businessName;\n                document.getElementById('whnz-display-business').innerText = whnzState.businessName;\n                \n                whnzGenerateQR();\n            });\n        }\n\n        // Generate QR Code dynamically sized based on format\n        function whnzGenerateQR() {\n            const qrContainer = document.getElementById(\"whnz-qr-canvas\");\n            qrContainer.innerHTML = \"\"; // clear previous\n\n            let qrSize = whnzState.currentFormat === 'whnz-format-wallet' ? 100 : 140;\n\n            whnzState.qrObj = new QRCode(qrContainer, {\n                text: whnzState.currentUrl,\n                width: qrSize,\n                height: qrSize,\n                colorDark : \"#000000\",\n                colorLight : \"#ffffff\",\n                correctLevel : QRCode.CorrectLevel.H\n            });\n        }\n\n        // Handle Download Process\n        // Exposed on window because the button uses an inline onclick=\n        // attribute, which looks up the function in the global scope \u2014\n        // this script otherwise runs in its own isolated scope, so the\n        // function was never actually reachable, silently failing.\n        window.whnzDownloadCard = function whnzDownloadCard() {\n            const btn = document.getElementById('whnz-download-btn');\n            const card = document.getElementById('whnz-card-export');\n            const originalText = btn.innerHTML;\n            \n            btn.innerHTML = \"Generating Print File...\";\n            btn.style.opacity = \"0.7\";\n            btn.disabled = true;\n\n            html2canvas(card, {\n                scale: 4, // Print resolution\n                useCORS: true,\n                backgroundColor: null\n            }).then(canvas => {\n                const link = document.createElement('a');\n                let safeName = whnzState.businessName.replace(/[^a-z0-9]/gi, '_').toLowerCase();\n                if(safeName === 'your_business_name' || safeName === '') safeName = 'google_review';\n                \n                let formatSuffix = whnzState.currentFormat === 'whnz-format-wallet' ? 'wallet_card' : 'stand_card';\n                link.download = `${safeName}_${formatSuffix}.png`;\n                link.href = canvas.toDataURL(\"image/png\", 1.0);\n                link.click();\n\n                btn.innerHTML = originalText;\n                btn.style.opacity = \"1\";\n                btn.disabled = false;\n            }).catch(err => {\n                console.error(\"Error generating image:\", err);\n                alert(\"There was an issue generating the image. Please try again.\");\n                btn.innerHTML = originalText;\n                btn.style.opacity = \"1\";\n                btn.disabled = false;\n            });\n        }\n\n        // Customizer Events\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            \n            // Manual URL\n            document.getElementById('whnz-manual-url').addEventListener('input', (e) => {\n                const val = e.target.value.trim();\n                if(val && val.startsWith('http')) {\n                    whnzState.currentUrl = val;\n                    whnzGenerateQR();\n                }\n            });\n\n            // Text live previews\n            document.getElementById('whnz-input-headline').addEventListener('input', (e) => {\n                document.getElementById('whnz-display-headline').innerText = e.target.value;\n            });\n            document.getElementById('whnz-input-business-name').addEventListener('input', (e) => {\n                whnzState.businessName = e.target.value;\n                document.getElementById('whnz-display-business').innerText = e.target.value;\n            });\n\n            // Custom Brand Colors\n            const cardContainer = document.getElementById('whnz-card-export');\n            document.getElementById('whnz-input-color-1').addEventListener('input', (e) => {\n                cardContainer.style.setProperty('--brand-color-1', e.target.value);\n            });\n            document.getElementById('whnz-input-color-2').addEventListener('input', (e) => {\n                cardContainer.style.setProperty('--brand-color-2', e.target.value);\n            });\n\n            // Theme Dropdown\n            document.getElementById('whnz-input-theme').addEventListener('change', (e) => {\n                cardContainer.className = cardContainer.className.replace(/whnz-theme-\\w+/, e.target.value);\n            });\n\n            // Format Size Dropdown\n            document.getElementById('whnz-input-format').addEventListener('change', (e) => {\n                const newFormat = e.target.value;\n                cardContainer.className = cardContainer.className.replace(/whnz-format-\\w+/, newFormat);\n                whnzState.currentFormat = newFormat;\n                whnzGenerateQR();\n            });\n\n            // Initialize Google Maps business-name autocomplete now that\n            // the Maps API script (loaded by the page component) is ready.\n            if (typeof google !== 'undefined' && google.maps && google.maps.places) {\n                initWhnzGoogleMaps();\n            }\n\n            // Initial Generate\n            setTimeout(whnzGenerateQR, 500);\n        });\n    "