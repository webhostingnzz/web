}/* ===========================
   NUCLEAR FIX: CHECKOUT WIDTH
   =========================== */

body.woocommerce-checkout form.checkout,
body.woocommerce-checkout .woocommerce-checkout,
body.woocommerce-checkout .woocommerce,
body.woocommerce-checkout #customer_details,
body.woocommerce-checkout .col2-set,
body.woocommerce-checkout .col2-set .col-1,
body.woocommerce-checkout .col2-set .col-2{
  width: 100% !important;
  max-width: 100% !important;
  float: none !important;
  flex: none !important;
}

/* If your theme wraps checkout inside a narrow column */
body.woocommerce-checkout .entry-content,
body.woocommerce-checkout .site-content,
body.woocommerce-checkout .content-area,
body.woocommerce-checkout .container,
body.woocommerce-checkout .elementor-container,
body.woocommerce-checkout .elementor-column,
body.woocommerce-checkout .elementor-widget-wrap{
  max-width: 100% !important;
}

/* Force all checkout rows to full width */
body.woocommerce-checkout form.checkout .form-row,
body.woocommerce-checkout form.checkout .form-row-first,
body.woocommerce-checkout form.checkout .form-row-last{
  width: 100% !important;
  max-width: 100% !important;
  float: none !important;
  clear: both !important;
  display: block !important;
}

/* Force ALL inputs to be full width (this beats most theme rules) */
body.woocommerce-checkout form.checkout .form-row input[type="text"],
body.woocommerce-checkout form.checkout .form-row input[type="email"],
body.woocommerce-checkout form.checkout .form-row input[type="tel"],
body.woocommerce-checkout form.checkout .form-row input[type="url"],
body.woocommerce-checkout form.checkout .form-row input[type="password"],
body.woocommerce-checkout form.checkout .form-row input[type="number"],
body.woocommerce-checkout form.checkout .form-row textarea,
body.woocommerce-checkout form.checkout .form-row select,
body.woocommerce-checkout form.checkout .select2-container,
body.woocommerce-checkout form.checkout .select2-container .select2-selection{
  width: 100% !important;
  max-width: 100% !important;
  min-height: 56px !important;
  box-sizing: border-box !important;
  display: block !important;
}

/* Make it a clean 2-column checkout on desktop */
@media (min-width: 992px){
  body.woocommerce-checkout form.checkout{
    display: grid !important;
    grid-template-columns: 1.25fr 0.75fr !important;
    gap: 28px !important;
    align-items: start !important;
  }
}

/* Card look */
body.woocommerce-checkout #customer_details,
body.woocommerce-checkout #order_review_heading,
body.woocommerce-checkout #order_review{
  background: #fff !important;
  border-radius: 16px !important;
  padding: 24px !important;
  box-shadow: 0 10px 25px rgba(0,0,0,.06) !important;
}
/* ======================================
   Webhosting NZ – Checkout (Aqua + White)
   ====================================== */
:root{
  --wnz-aqua:#0CC0DF;
  --wnz-aqua2:#0aa3bd;
  --wnz-bg:#ffffff;
  --wnz-card:#ffffff;
  --wnz-border:#e6f3f8;
  --wnz-text:#0b1b2b;
  --wnz-muted:#5f6f82;
}

/* Page background */
body.woocommerce-checkout{
  background: var(--wnz-bg) !important;
}

/* Container */
body.woocommerce-checkout .woocommerce{
  max-width: 1220px;
  margin: 0 auto;
  padding: 18px 14px 40px;
}

/* Main 2-col layout */
@media (min-width: 992px){
  body.woocommerce-checkout form.checkout{
    display:grid !important;
    grid-template-columns: 1.35fr 0.65fr !important;
    gap: 26px !important;
    align-items:start !important;
  }
}

/* Left column sections look like "steps" */
body.woocommerce-checkout #customer_details{
  background: transparent !important;
  padding: 0 !important;
  box-shadow: none !important;
}

/* Turn default billing/shipping blocks into cards */
body.woocommerce-checkout #customer_details .woocommerce-billing-fields,
body.woocommerce-checkout #customer_details .woocommerce-additional-fields{
  background: var(--wnz-card) !important;
  border: 1px solid var(--wnz-border) !important;
  border-radius: 18px !important;
  padding: 22px !important;
  box-shadow: 0 14px 30px rgba(15, 35, 55, .06) !important;
  margin-bottom: 16px !important;
}

/* Step card (our Project Info) */
.wnz-step-card{
  background: var(--wnz-card);
  border: 1px solid var(--wnz-border);
  border-radius: 18px;
  padding: 22px;
  box-shadow: 0 14px 30px rgba(15, 35, 55, .06);
  margin-bottom: 16px;
}

/* Step header */
.wnz-step-head{
  display:flex;
  align-items:center;
  gap: 12px;
  margin-bottom: 14px;
}
.wnz-step-badge{
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--wnz-aqua), var(--wnz-aqua2));
  box-shadow: 0 10px 18px rgba(12,192,223,.22);
}
body.woocommerce-checkout h3{
  margin: 0 0 8px !important;
  font-size: 20px;
  color: var(--wnz-text);
}

/* Inputs */
body.woocommerce-checkout .form-row{ margin-bottom: 14px !important; }
body.woocommerce-checkout label{
  font-weight: 650;
  color: var(--wnz-text);
  margin-bottom: 6px;
  display:block;
}
body.woocommerce-checkout input.input-text,
body.woocommerce-checkout textarea,
body.woocommerce-checkout select,
body.woocommerce-checkout .select2-container .select2-selection{
  width:100% !important;
  max-width:100% !important;
  min-height: 54px !important;
  padding: 12px 14px !important;
  border-radius: 12px !important;
  border: 1px solid #d7eef6 !important;
  background: #f8fcff !important;
  box-sizing: border-box !important;
}
body.woocommerce-checkout textarea{ min-height: 110px !important; resize: vertical; }

/* Focus */
body.woocommerce-checkout input:focus,
body.woocommerce-checkout textarea:focus,
body.woocommerce-checkout select:focus{
  border-color: var(--wnz-aqua) !important;
  box-shadow: 0 0 0 4px rgba(12,192,223,.16) !important;
  outline: none !important;
}

/* Radio as “cards” (Yes/No website) */
.wnz-radio-cards .woocommerce-input-wrapper{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.wnz-radio-cards .woocommerce-input-wrapper label{
  margin:0;
  border:1px solid #d7eef6;
  background:#ffffff;
  border-radius:14px;
  padding:16px 14px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  font-weight:700;
  color: var(--wnz-text);
  transition: .2s;
}
.wnz-radio-cards input[type="radio"]{
  display:none !important;
}
.wnz-radio-cards input[type="radio"]:checked + label{
  border-color: var(--wnz-aqua);
  box-shadow: 0 0 0 4px rgba(12,192,223,.14);
}

/* Right column: Order summary card */
body.woocommerce-checkout #order_review_heading,
body.woocommerce-checkout #order_review{
  background: var(--wnz-card) !important;
  border: 1px solid var(--wnz-border) !important;
  border-radius: 18px !important;
  padding: 22px !important;
  box-shadow: 0 14px 30px rgba(15, 35, 55, .06) !important;
}

body.woocommerce-checkout #order_review_heading{
  margin:0 0 12px !important;
}

/* Sticky summary */
@media (min-width: 992px){
  body.woocommerce-checkout #order_review{
    position: sticky;
    top: 110px;
  }
}

/* Place order button */
body.woocommerce-checkout #place_order{
  width:100% !important;
  min-height: 56px !important;
  border-radius: 14px !important;
  font-size: 16px !important;
  font-weight: 800 !important;
  background: linear-gradient(90deg, var(--wnz-aqua), var(--wnz-aqua2)) !important;
  border: none !important;
  box-shadow: 0 14px 22px rgba(12,192,223,.22) !important;
}
body.woocommerce-checkout #place_order:hover{
  filter: brightness(.97);
  transform: translateY(-1px);
}/* --- 1. RESET & VARIABLES --- */
:root {
  --wnz-bg: #f8faff;
  --wnz-primary: #0CC0DF;
  --wnz-radius: 12px;
}

/* Force the checkout background */
.wnz-modern-checkout .woocommerce {
  background: var(--wnz-bg) !important;
}

/* --- 2. MASTER GRID LAYOUT --- */
/* This forces the layout to ignore theme floats */
.wnz-layout-grid {
  display: grid !important;
  /* 66% content, 33% sidebar */
  grid-template-columns: 66% 1fr !important; 
  gap: 30px !important;
  max-width: 1140px !important;
  margin: 40px auto !important;
  padding: 0 20px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* --- 3. MAIN COLUMN (LEFT) --- */
/* This stacks Step 1 and Step 2 vertically */
.wnz-main-col {
  display: flex !important;
  flex-direction: column !important;
  gap: 25px !important;
  width: 100% !important;
  min-width: 0 !important; /* Prevents grid blowout */
}

/* --- 4. STEP CARDS --- */
.wnz-step-card {
  background: #ffffff !important;
  border-radius: var(--wnz-radius) !important;
  padding: 30px !important;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05) !important;
  border: 1px solid #e2e8f0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
  margin: 0 !important; /* Remove theme margins */
  float: none !important; /* Disable theme floats */
}

/* --- 5. SIDEBAR (RIGHT) --- */
.wnz-sidebar-col {
  width: 100% !important;
  min-width: 0 !important;
}

.wnz-sticky-sidebar {
  position: sticky !important;
  top: 30px !important;
  z-index: 99;
}

/* --- 6. RADIO BUTTON FIX --- */
/* Makes the "Yes/No" buttons look like nice cards */
.wnz-radio-cards .woocommerce-input-wrapper {
  display: flex !important;
  gap: 15px !important;
}
.wnz-radio-cards label.radio {
  flex: 1 !important;
  background: #fff !important;
  border: 1px solid #ddd !important;
  padding: 15px !important;
  border-radius: 8px !important;
  text-align: center !important;
  cursor: pointer !important;
}

/* --- 7. MOBILE FIX --- */
@media (max-width: 980px) {
  .wnz-layout-grid {
    display: flex !important;
    flex-direction: column !important;
  }
  .wnz-layout-grid > div {
    width: 100% !important;
  }
}

/* --- 8. HIDE DEFAULT THEME ELEMENTS --- */
.woocommerce-billing-fields > h3, 
.woocommerce-additional-fields > h3, 
#order_review_heading {
  display: none !important;
}/* Show Elementor TOC only on single blog posts */
body:not(.single-post) .elementor-widget-table-of-contents{
  display:none !important;
}
</style>
</head>
