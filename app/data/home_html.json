\n            border: 2px solid rgba(12,192,223,0.2);\n            border-radius: 20px;\n            padding: 28px 22px 24px;\n            backdrop-filter: blur(28px) saturate(160%);\n            -webkit-backdrop-filter: blur(28px) saturate(160%);\n            box-shadow: 0 8px 40px rgba(0,0,0,0.04);\n            transition: all 0.32s ease;\n            position: relative;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .whnz-card::after {\n            content: '';\n            position: absolute;\n            top: 0; left: 0; right: 0; height: 3px;\n            background: linear-gradient(90deg, transparent, #0CC0DF, transparent);\n            transform: scaleX(0);\n            transition: transform 0.32s ease;\n        }\n\n        .whnz-card:hover {\n            transform: translateY(-10px);\n            border-color: rgba(12,192,223,0.5);\n            box-shadow: 0 32px 80px rgba(12,192,223,0.15);\n        }\n        .whnz-card:hover::after { transform: scaleX(1); }\n\n        /* MODIFIED: Centered Icon */\n        .whnz-card-icon {\n            width: 54px; height: 54px;\n            background: #0CC0DF;\n            border-radius: 14px;\n            display: flex; align-items: center; justify-content: center;\n            margin: 0 auto 18px auto; \n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);\n        }\n        .whnz-card-icon img {\n            width: 26px;\n            height: 26px;\n        }\n\n        /* MODIFIED: Centered Heading */\n        .whnz-card h3 {\n            font-family: 'Outfit', sans-serif;\n            font-size: 18px; font-weight: 700;\n            color: #000000; margin-bottom: 8px;\n            letter-spacing: -0.01em;\n            text-align: center;\n        }\n\n        /* MODIFIED: Centered Description */\n        .whnz-card-desc {\n            font-size: 13px; color: rgba(0,0,0,0.7);\n            line-height: 1.65; margin-bottom: 18px;\n            text-align: center;\n        }\n\n        .whnz-divider {\n            height: 1px;\n            background: rgba(0,0,0,0.1);\n            margin-bottom: 16px;\n        }\n\n        .whnz-feats { list-style: none; margin-bottom: 22px; flex: 1; }\n        .whnz-feats li {\n            font-size: 12.5px; color: #000000;\n            padding: 5px 0;\n            display: flex; align-items: center; gap: 9px;\n            font-weight: 600;\n        }\n        .whnz-feats li::before {\n            content: '\u2713';\n            width: 17px; height: 17px;\n            background: rgba(12,192,223,0.15);\n            border: 1px solid rgba(12,192,223,0.4);\n            color: #0CC0DF; border-radius: 50%;\n            display: inline-flex; align-items: center; justify-content: center;\n            font-size: 9px; font-weight: 800;\n            flex-shrink: 0;\n        }\n\n        /* MODIFIED: Centered Price Area */\n        .whnz-price {\n            margin-bottom: 18px;\n            display: flex; align-items: baseline; gap: 2px;\n            justify-content: center;\n        }\n        .whnz-price .cur {\n            font-family: 'Outfit', sans-serif;\n            font-size: 13px; font-weight: 700;\n            color: #0CC0DF;\n            align-self: flex-start; margin-top: 4px;\n        }\n        .whnz-price .amt {\n            font-family: 'Outfit', sans-serif;\n            font-size: 44px; font-weight: 800;\n            color: #000000; line-height: 1;\n            letter-spacing: -0.03em;\n        }\n        .whnz-price .cts {\n            font-family: 'Outfit', sans-serif;\n            font-size: 18px; font-weight: 700;\n            color: #000000;\n            align-self: flex-start; margin-top: 6px;\n        }\n        .whnz-price .mo {\n            font-size: 12px; color: rgba(0,0,0,0.5); margin-left: 4px;\n        }\n\n        .whnz-card-btn {\n            display: block; width: 100%; text-align: center;\n            background: transparent;\n            border: 2px solid rgba(12,192,223,0.5);\n            color: #0CC0DF !important; padding: 12px;\n            border-radius: 10px;\n            font-weight: 700; font-size: 12px;\n            letter-spacing: 0.08em; text-transform: uppercase;\n            text-decoration: none !important;\n            transition: all 0.25s ease;\n        }\n        .whnz-card-btn:hover {\n            background: #0CC0DF;\n            color: #ffffff !important;\n            border-color: #0CC0DF;\n            box-shadow: 0 4px 20px rgba(12,192,223,0.3);\n        }\n\n        /* \u2500\u2500 RESPONSIVE \u2500\u2500 */\n        @media (max-width: 1100px) {\n            .whnz-cards-grid { grid-template-columns: repeat(2, 1fr); }\n        }\n\n        /* Mobile Adjustments */\n        @media (max-width: 900px) {\n            .whnz-hero {\n                min-height: auto;\n                padding-top: 90px; /* Keeps hero text safely below mobile headers */\n                padding-bottom: 0px; \n            }\n            .whnz-hero-inner { \n                display: flex; \n                flex-direction: column; \n                text-align: center; \n                gap: 0;\n            }\n            .whnz-hero-left {\n                margin-left: 0; /* Resets the text offset on mobile */\n                display: contents; /* Allows children to be sorted alongside image */\n            }\n            .whnz-hero-tag { order: 1; margin: 0 auto 15px; }\n            .whnz-hero h1 { order: 2; margin-bottom: 5px; }\n            \n            .whnz-hero-right { \n                order: 3; \n                margin: 5px 0 10px; /* Overrides the desktop -80px margin */\n                justify-content: center; \n            }\n\n            .whnz-hero-img {\n                max-width: 100%; \n                margin: 0 auto;\n            }\n            \n            .whnz-hero-sub { order: 4; margin: 0 auto 20px; font-size: 15px; }\n            .whnz-cta-row { order: 5; justify-content: center; margin-bottom: 20px; }\n            \n            .whnz-why {\n                padding-top: 20px; \n            }\n            .whnz-why-grid { grid-template-columns: repeat(2, 1fr); }\n        }\n\n        @media (max-width: 600px) {\n            .whnz-hero, .whnz-plans, .whnz-why { padding-left: 20px; padding-right: 20px; }\n            .whnz-cards-grid, .whnz-why-grid { grid-template-columns: 1fr; }\n        }\n    </style>\n\n    <div class=\"whnz-wrap\">\n\n        <section class=\"whnz-hero\">\n            <div class=\"whnz-hero-inner\">\n                <div class=\"whnz-hero-left\">\n                    <div class=\"whnz-hero-tag whnz-animate-up whnz-delay-1\">\n                        <i>\u2713</i>&nbsp;Fully Managed Web Hosting\n                    </div>\n                    <h1 class=\"whnz-animate-up whnz-delay-2\">Smart Web<br>Hosting <em>in NZ</em></h1>\n                    <p class=\"whnz-hero-sub whnz-animate-up whnz-delay-3\">High-performance hosting for agencies, ecommerce, business &amp; side-hustlers.</p>\n                    <div class=\"whnz-cta-row whnz-animate-up whnz-delay-4\">\n                        <a href=\"#hosting-plans\" class=\"whnz-btn-solid\">Hosting</a>\n                        <a href=\"#host\" class=\"whnz-btn-ghost\">Domains</a>\n                    </div>\n                </div>\n\n                <div class=\"whnz-hero-right whnz-animate-up whnz-delay-5\">\n                    <img decoding=\"async\" fetchpriority=\"high\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2026/02/Untitled-design-78.webp\" alt=\"WebHosting NZ Server\" class=\"whnz-hero-img\">\n                </div>\n            </div>\n        </section>\n\n        <section class=\"whnz-logo-slider\">\n            <div class=\"whnz-logo-slider-inner\">\n                <div class=\"whnz-logo-marquee\">\n                    <div class=\"whnz-logo-track\">\n\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/google-cloud-img.webp\" alt=\"Google Cloud\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/digital-ocean-img.webp\" alt=\"DigitalOcean\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/aws-img.webp\" alt=\"AWS\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/linode-img.webp\" alt=\"Linode\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/malcare-img.webp\" alt=\"MalCare\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/cloud-flare-img.webp\" alt=\"Cloudflare\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/object-cache-pro-img.webp\" alt=\"Object Cache Pro\"></div>\n\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/google-cloud-img.webp\" alt=\"Google Cloud\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/digital-ocean-img.webp\" alt=\"DigitalOcean\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/aws-img.webp\" alt=\"AWS\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/linode-img.webp\" alt=\"Linode\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/malcare-img.webp\" alt=\"MalCare\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/cloud-flare-img.webp\" alt=\"Cloudflare\"></div>\n                        <div class=\"whnz-logo-slide\"><img decoding=\"async\" src=\"/images/wp-imported/webhosting.co.nz/uploads/2024/06/object-cache-pro-img.webp\" alt=\"Object Cache Pro\"></div>\n\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"whnz-why\">\n            <div class=\"whnz-why-hd whnz-animate-scroll whnz-delay-1\">\n                <span class=\"whnz-eyebrow\">Why Choose Us</span>\n                <h2 class=\"whnz-heading\">The Best NZ Web Host<br>for Small Businesses</h2>\n            </div>\n            <p class=\"whnz-why-sub whnz-animate-scroll whnz-delay-2\">WebHosting.co.nz is a New Zealand based web hosting service purpose-built for NZ businesses that need reliable, fast, and affordable hosting without the complexity.</p>\n\n            <div class=\"whnz-why-grid\">\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-1\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n                    </div>\n                    <h4>99.9% Uptime Guarantee</h4>\n                    <p>Your site stays online every hour of every day \u2014 backed by our enterprise-grade NZ infrastructure.</p>\n                </div>\n\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-2\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0110 0v4\"/></svg>\n                    </div>\n                    <h4>Free SSL Certificate</h4>\n                    <p>On every plan \u2014 encrypt traffic and build visitor trust instantly with wildcard SSL included.</p>\n                </div>\n\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-3\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n                    </div>\n                    <h4>NZ Based Infrastructure</h4>\n                    <p>Servers located in Auckland with global CDN coverage for blazing-fast local performance.</p>\n                </div>\n\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-4\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n                    </div>\n                    <h4>Domain Registration</h4>\n                    <p>Search, register and manage your domain name in one place \u2014 seamlessly integrated with hosting.</p>\n                </div>\n\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-5\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 00-3-3.87\"/><path d=\"M16 3.13a4 4 0 010 7.75\"/></svg>\n                    </div>\n                    <h4>Local Support Team</h4>\n                    <p>Talk to real people who understand your business needs \u2014 our NZ team is always available.</p>\n                </div>\n\n                <div class=\"whnz-why-card whnz-animate-scroll whnz-delay-6\">\n                    <div class=\"whnz-why-ico\">\n                        <svg viewBox=\"0 0 24 24\"><polyline poi