-items: center; flex-shrink: 0; margin-right: auto; text-decoration: none; } .whnz_nav_wrapper .whnz-logo img { height: 42px; width: auto; display: block; transition: height .3s ease; object-fit: contain; } .whnz_nav_wrapper.scrolled .whnz-logo img { height: 36px; } .whnz_nav_wrapper .whnz-nav { display: flex; align-items: center; gap: 8px; } .whnz_nav_wrapper .whnz-link, .whnz_nav_wrapper .whnz-dropbtn { text-decoration: none; color: var(--whnz-ink); font-weight: 700; font-size: 13px; letter-spacing: .5px; padding: 10px 14px; border-radius: 8px; white-space: nowrap; background: transparent; border: none; cursor: pointer; transition: all .15s ease; display: inline-flex; align-items: center; gap: 6px; } .whnz_nav_wrapper .whnz-link:hover, .whnz_nav_wrapper .whnz-dropbtn:hover, .whnz_nav_wrapper .whnz-dropbtn.is-active { background: rgba(12,192,223,.12); color: var(--whnz-accent); } .whnz_nav_wrapper .whnz-caret { width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); display: inline-block; transition: transform .2s ease; margin-bottom: 2px; } .whnz_nav_wrapper .whnz-dropbtn.is-active .whnz-caret { transform: rotate(225deg); margin-bottom: -2px;} .whnz_nav_wrapper .whnz-new-tag { background: linear-gradient(135deg, #ff6b6b, #ff5252); color: #fff; font-size: 9px; font-weight: 900; padding: 2px 6px; border-radius: 4px; line-height: 1; } .whnz_nav_wrapper .whnz-client { background: var(--whnz-accent); color: #fff; padding: 10px 18px; border-radius: 10px; font-weight: 800; font-size: 13px; letter-spacing: .5px; text-decoration: none; white-space: nowrap; box-shadow: 0 4px 14px rgba(12,192,223,.25); transition: transform .2s ease, box-shadow .2s ease; } .whnz_nav_wrapper .whnz-client:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(12,192,223,.35); } /* Mega Menu (Always solid card for legibility) */ .whnz_nav_wrapper-mega { position: fixed; width: min(640px, calc(100vw - 32px)); paddi